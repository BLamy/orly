{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Storyboard",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "title",
    "throughline",
    "chapters"
  ],
  "properties": {
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 80,
      "description": "Overall storyboard title (the subsystem being explained)."
    },
    "subtitle": {
      "type": "string",
      "maxLength": 140,
      "description": "Optional one-line subtitle for the whole storyboard."
    },
    "throughline": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200,
      "description": "The single protagonist/journey the storyboard follows end to end, e.g. 'one secret from sign-in to an encrypted vault and back'. Keeps narration coherent; not rendered directly."
    },
    "chapters": {
      "type": "array",
      "minItems": 3,
      "maxItems": 6,
      "description": "3-6 chapters; numbers sequential from 1. Each maps to one narration MP3.",
      "items": {
        "$ref": "#/$defs/chapter"
      }
    }
  },
  "$defs": {
    "nodeId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$",
      "description": "Lowercase kebab/alnum id, unique within its chapter."
    },
    "chapter": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "number",
        "title",
        "blurb",
        "accent",
        "nodes",
        "edges",
        "steps"
      ],
      "properties": {
        "number": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6,
          "description": "1-based sequential chapter number, no gaps."
        },
        "title": {
          "type": "string",
          "minLength": 3,
          "maxLength": 60,
          "description": "Chapter name (also the cover headline)."
        },
        "blurb": {
          "type": "string",
          "minLength": 10,
          "maxLength": 160,
          "description": "One sentence describing the chapter; shown on the chapter menu card."
        },
        "accent": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$",
          "description": "Hex accent color for the chapter card. Vary across chapters."
        },
        "nodes": {
          "type": "array",
          "minItems": 4,
          "maxItems": 8,
          "description": "4-8 nodes scoped to this chapter. Centers must not overlap: >=18 apart in x OR >=12 apart in y.",
          "items": {
            "$ref": "#/$defs/node"
          }
        },
        "edges": {
          "type": "array",
          "minItems": 0,
          "maxItems": 16,
          "description": "Real connections between this chapter's nodes.",
          "items": {
            "$ref": "#/$defs/edge"
          }
        },
        "steps": {
          "type": "array",
          "minItems": 6,
          "maxItems": 12,
          "description": "Ordered steps. Index 0 MUST be a cover. Union of all reveal arrays MUST equal the chapter's node ids.",
          "items": {
            "$ref": "#/$defs/step"
          }
        }
      }
    },
    "node": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "label",
        "kind",
        "x",
        "y"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 28,
          "description": "Short real component name from the digest."
        },
        "sublabel": {
          "type": "string",
          "maxLength": 36,
          "description": "Optional short real detail (path/tech/qualifier)."
        },
        "kind": {
          "type": "string",
          "enum": [
            "client",
            "loadbalancer",
            "service",
            "database",
            "cache",
            "queue",
            "worker",
            "external",
            "vault",
            "key",
            "proxy",
            "record"
          ]
        },
        "x": {
          "type": "number",
          "minimum": 6,
          "maximum": 94,
          "description": "Center x in 0-100 stage coords; left=upstream, right=downstream."
        },
        "y": {
          "type": "number",
          "minimum": 12,
          "maximum": 88,
          "description": "Center y in 0-100 stage coords; spread nodes, don't cram at 50."
        }
      }
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "to": {
          "$ref": "#/$defs/nodeId"
        },
        "label": {
          "type": "string",
          "maxLength": 28
        },
        "dashed": {
          "type": "boolean",
          "description": "Async/background/optional path."
        }
      }
    },
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to",
        "kind"
      ],
      "properties": {
        "from": {
          "$ref": "#/$defs/nodeId"
        },
        "to": {
          "$ref": "#/$defs/nodeId"
        },
        "label": {
          "type": "string",
          "maxLength": 22
        },
        "kind": {
          "type": "string",
          "enum": [
            "request",
            "response",
            "data",
            "event"
          ]
        },
        "delay": {
          "type": "number",
          "minimum": 0,
          "maximum": 10000,
          "description": "ms before this packet departs; chain hops within a step."
        },
        "duration": {
          "type": "number",
          "minimum": 200,
          "maximum": 4000,
          "description": "ms in flight; default ~950."
        }
      }
    },
    "badge": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "node",
        "text",
        "tone"
      ],
      "properties": {
        "node": {
          "$ref": "#/$defs/nodeId"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "maxLength": 14
        },
        "tone": {
          "type": "string",
          "enum": [
            "ok",
            "warn",
            "info"
          ]
        }
      }
    },
    "step": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "title",
        "displayNarration",
        "spoken",
        "sourceRefs"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/nodeId"
        },
        "cover": {
          "type": "boolean",
          "description": "True only for the first step of a chapter (title card; reveals/animates nothing)."
        },
        "coverSubtitle": {
          "type": "string",
          "maxLength": 140,
          "description": "Subtitle under the cover headline; cover steps only."
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60,
          "description": "Short on-screen headline."
        },
        "displayNarration": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Panel markdown: **bold** term, *italic*, `code` for real identifiers. 1-3 sentences."
        },
        "spoken": {
          "type": "string",
          "minLength": 1,
          "maxLength": 600,
          "description": "Clean TTS text: no markdown/backticks/symbols. Self-contained; concatenates with sibling steps into one script."
        },
        "sourceRefs": {
          "type": "array",
          "minItems": 1,
          "description": "Digest citations (file or file:symbol) backing this step's claims.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "reveal": {
          "type": "array",
          "description": "Node ids first appearing here (cumulative). Union over a chapter == its node set.",
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "hide": {
          "type": "array",
          "description": "Node ids to remove here (rare; cumulative).",
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "highlight": {
          "type": "array",
          "description": "Node ids to spotlight; others dim. Omit for a wide view.",
          "items": {
            "$ref": "#/$defs/nodeId"
          }
        },
        "badges": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/badge"
          }
        },
        "messages": {
          "type": "array",
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/message"
          }
        },
        "viz": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "scene"
          ],
          "description": "Embed a 3b1b-style animated scene for this step. While the step is active the player renders the scene INSTEAD of the diagram; the step's spoken narration still drives the audio. Without `beat` the whole scene is time-scaled onto the step's audio window; with `beat` only that beat's window plays (beats = the scene's caption start times), so N consecutive steps with beat 0..N-1 play one authored scene end to end. Never on a cover step.",
          "properties": {
            "scene": {
              "type": "string",
              "pattern": "^([a-z0-9][a-z0-9-]*|books/[a-z0-9_][a-z0-9_-]*/[a-z0-9_][a-z0-9_-]*)$",
              "description": "A catalog slug from generator/viz-catalog.json (e.g. 'raft'), or a book-local scene 'books/<bookSlug>/<name>' backed by apps/bookshelf/src/viz/books/<bookSlug>/<name>.tsx (which must exist — the validator hard-errors otherwise)."
            },
            "beat": {
              "type": "integer",
              "minimum": 0,
              "description": "0-based beat index into the scene (its caption start times). Step i of a chapter's scene should carry beat i-of-the-scene; omit to time-scale the whole scene onto this one step."
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "cover": {
                "const": true
              }
            },
            "required": [
              "cover"
            ]
          },
          "then": {
            "properties": {
              "reveal": {
                "maxItems": 0
              },
              "messages": {
                "maxItems": 0
              },
              "badges": {
                "maxItems": 0
              },
              "highlight": {
                "maxItems": 0
              }
            }
          }
        }
      ]
    }
  }
}