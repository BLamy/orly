  .velocity(0.07).attack(1.5).release(1.4).lpf(900)
// 'kleene' (180.62): M4, the 1943 reed, quotes its first phrase once (E-G-A-G): Kleene's finite machine, found again
$: room(tl([180.62, 4.6, note("e4@1.1 g4@1.1 a4@1.6 g4@0.8")])).s("gm_clarinet").velocity(0.11).attack(0.2).release(1.0).lpf(900)
