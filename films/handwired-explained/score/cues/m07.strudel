$: hits(run(172.40, 3, 0.26, ["a4"], 0.18, 0.18, 0.1)).s("gm_woodblock").decay(0.05).sustain(0)
$: hits(run(172.40, 3, 0.26, ["e2"], 0.12, 0.12, 0.2)).s("gm_taiko_drum").decay(0.12).sustain(0)
// 'monitor' (174.02): the pulse slows back to the even escapement, on A (the dominant): the return is prepared
$: room(tl([174.02, 5.70, note("[a2,c#3,e3,g3]")])).s("gm_string_ensemble_1").velocity(0.06).attack(1.0).release(0.8).lpf(800)
$: tl([174.02, 5.70, loop(note("a1 e2 c#2 e2 ~"), 5.70)]).s("gm_pizzicato_strings").velocity(0.15).lpf(800).mul(velocity(speech(0.75)))

// ================================================================ ch06-s12: THE RETURN, in D, slower and fuller
// the escapement is back (see THE ESCAPEMENT) with a low harp wheel under it and a fuller string bed
$: tl([179.72, 4.85 * F, loop(note("d2 a2 f#2 a2 ~"), 4.85 * F)]).s("gm_orchestral_harp").velocity(0.18).lpf(800).pan(0.4)
  .mul(velocity(speech(0.75)))
