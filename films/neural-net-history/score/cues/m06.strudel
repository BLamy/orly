// m06 "The Messenger" (neural-net-history), 448.477-555.65 s (107.173 s). F major (dawnGold), 63 BPM where metric.
// CLOCK RE-FIT (2026-10-12, clock 2139.54 s): the re-narrated L0505 ("At the sterile candle's rim...") is 0.583 s
// longer, so every event from the desks' second key ("travel") on moves +0.75 s and everything before it +0.167 s
// (the cue's bodily shift); the window grows to 107.173 s so the fade (554.85-555.65) starts after L0512 (554.658).
// Masking pass (score round 2): the training scrub, XOR check and music box (L0509), the sterile candle's
// clarinet and cello (L0521), the Boltzmann flicker, desk walk and ticks (L0505b) trimmed; the training's
// string bed loses its D3/E3 (now below the voice).
// Review round 1 re-fit: every hit is placed on the NEW clock (narration/timeline.json, film 2121.42 s).
// setcps(1): one cycle = one second; events at ABSOLUTE film seconds (line() subtracts S).
// M3 is born: up (light flows forward), a held question (the error glows), back down (the messenger tugs
// each knob), and the trained forward pass lands on the THIRD (A over F: solved).
// gm_celesta sounds an octave up (written f4 = heard F5); gm_pad_bowed sounds two octaves up (written f3 = F5).
//
//  448.477-452.267 IN (join gap 445.247-452.227): over m05's fading D-A-E, F major arrives in the strings (F/A, low;
//               A is common to both) and a slow celesta figure in a large gilded room sounds in the clear
//               (450.567, 451.367), before "Versailles" (452.227).
//  452.267-470.467  VERSAILLES: the thaw. A ring of eight on "network" (456.137); half of it on "half" (457.457); a slow
//               roll downhill on "rolls downhill" (458.867); on "whole" (461.267) the texture thins to ONE
//               sustained high E (the leading note: nothing resolves) through "I have never met anyone...".
//  470.467-483.85  THE DESKS: a pizzicato walk with a soft 1980s tick, a key per desk: F, G on "travel" (475.19),
//               Ab on the Boltzmann net (476.19), F again on "Toronto" (481.17); at "hot" (478.16) a shimmer of
//               random high celesta notes that settles into an Ab chord on "settle" (479.08); a low cello D
//               pedal beneath (the sterile candle's season).
//  485.15-526.95  THE MESSENGER: forward arpeggio F A C F word-locked to "Light flows up through layers"
//               (492.31); one note for "checked" (497.11); the error glows (499.04): G held over an F-Gb glass
//               rub; the messenger runs back down G F C A F on "runs back down, lantern by lantern" (501.52-
//               504.92) with pizz tugs on "tugging each knob" and "blame" (507.86); the training scrub
//               (508.96-512.74) accelerates and brightens; four answering notes for the XOR check (512.89:
//               low high high low); "By itself" (514.19) lands on A over F with a warm string swell in the clear
//               air; a wondering figure for the family trees (517.48); the sterile candle's own colour returns
//               (low clarinet D4 over a cello D-A) and falls D -> C# over A exactly on "seventeen" (523.76); a
//               breath of near silence under the quote card.
//  527.15-536.45  THE MISTY HILLS: a low uncertain fog (G minor), muted footstep plucks downhill, stalling on an
//               unresolved A in the hollow (530.65); the bold leap (533.09): strings C -> F, landing warmly on F.
//  536.45-555.65  WHO INVENTED IT: the question card burns out (536.39-537.79): M1's clean fall, C -> F -> E over
//               C, very soft; the study: low clarinet, the lamp's hum; a plucked note per thread (543.56 ...),
//               the warmest on "Helsinki" (544.75); Hinton's quote (550.13-554.66) in near silence over a last
//               soft F (550.75, the last onset). Faded 554.85-555.65; m07 opens with the false-clue walk.
setcps(1)

const S = 448.477
const N = 108
const G = 2.9
const B = 60 / 63

function line(evs, defs) {
  defs = defs || {}
  evs = evs.map((e) => [e[0] - S, e[1], e[2], e[3], e[4]])
  const sorted = [...evs].sort((a, b) => a[0] - b[0])
  const lanes = []
  for (const e of sorted) {
    let lane = lanes.find((l) => l.end <= e[0] + 1e-6)
    if (!lane) { lane = { end: 0, evs: [] }; lanes.push(lane) }
    lane.evs.push(e)
    lane.end = e[0] + e[1]
  }
  const DEF = { attack: .01, release: .3, decay: 0, sustain: 1, lpf: 18000, pan: .5 }
  const keys = [...new Set([...Object.keys(defs), ...evs.flatMap((e) => Object.keys(e[4] || {}))])]
  const seq = (lane, val) => {
    let pos = 0
    const out = []
    for (const e of lane.evs) {
      if (e[0] - pos > 1e-6) out.push('~@' + (e[0] - pos).toFixed(4))
      out.push(val(e) + '@' + e[1].toFixed(4))
      pos = e[0] + e[1]
    }
    if (N - pos > 1e-6) out.push('~@' + (N - pos).toFixed(4))
    return mini('[' + out.join(' ') + ']')
  }
  return stack(...lanes.map((lane) => {
    let p = note(seq(lane, (e) => e[2])).velocity(seq(lane, (e) => e[3]))
    for (const k of keys) p = p[k](seq(lane, (e) => (e[4] && e[4][k] != null ? e[4][k] : defs[k] != null ? defs[k] : DEF[k])))
    return p.slow(N)
  }))
}

// the training scrub: forward/back passes that accelerate (start, end, first step, last step)
function scrub(t0, t1, d0, d1) {
  const up = ['f4', 'a4', 'c5', 'f5'], down = ['g5', 'f5', 'c5', 'a4']
  const ev = []
  let t = t0, k = 0
  while (t < t1) {
    const x = (t - t0) / (t1 - t0)
    const d = d0 + (d1 - d0) * x
    const n = (Math.floor(k / 4) % 2 ? down : up)[k % 4]
    ev.push([t, d * .95, n, .09 + .05 * x])
    t += d
    k++
  }
  return ev
}

// ------------------------------------------------------------------ celesta (heard an octave up)
const HOT = 478.16
const hot = [0, .16, .27, .41, .5, .61, .68].map((d) => HOT + d)
const hotNotes = ['e6', 'b5', 'f6', 'c6', 'g5', 'd6', 'a5']
$: line([
  // Versailles: a slow figure in the clear, then the ring, half of it, the roll
  [450.567, 1.2, 'a4', .14], [451.367, 1.5, 'c5', .13],
  ...['f4', 'a4', 'c5', 'e5', 'f5', 'e5', 'c5', 'a4'].map((n, k) => [456.137 + k * .16, .5, n, .11]),   // the ring of eight
  ...['f4', 'a4', 'c5', 'e5'].map((n, k) => [457.457 + k * .22, .6, n, .12]),                              // half a memory
  ...['g5', 'f5', 'e5', 'd5', 'c5'].map((n, k) => [458.867 + k * .45, .8, n, .12 - k * .008]),              // rolls downhill
  // the Boltzmann net: hot, then settling into Ab
  ...hot.map((t, k) => [t, .3, hotNotes[k], .075]),
  [479.08, 2.0, '[ab4,c5,eb5]', .1],
  // THE MESSENGER: forward, word-locked ("Light flows up through layers")
  [492.31, .6, 'f4', .15], [492.65, .6, 'a4', .15], [493.05, .6, 'c5', .16], [493.5, 1.2, 'f5', .17],
  [497.11, 1.2, 'g5', .16],                                                    // checked against the right one
  [499.04, 1.6, 'g4', .2],                                                     // the error glows (G over F-Gb)
  // the messenger runs back down, lantern by lantern
  [501.52, .9, 'g5', .15], [502.88, .5, 'f5', .15], [503.49, .7, 'c5', .15], [504.25, .6, 'a4', .15], [504.92, 1.0, 'f4', .15],
  // training: accelerating and brightening
  ...scrub(508.96, 512.74, .42, .14),
  // the XOR check: low high high low
  [512.89, .3, 'c5', .13], [513.17, .3, 'f5', .16], [513.45, .3, 'f5', .16], [513.73, .3, 'c5', .13],
  // the trained forward pass lands on the THIRD: "By itself"
  [513.91, .12, 'f4', .2], [513.99, .12, 'a4', .2], [514.07, .12, 'c5', .2], [514.19, 2.5, '[f5,a5]', .22],
  // the family trees: a lighter, wondering figure
  [517.48, .3, 'c5', .14], [517.74, .3, 'd5', .14], [517.99, .9, 'g5', .15],
  // the question card burns out: M1's clean fall, F -> E over C, very soft
  [536.49, .5, 'c5', .1], [536.99, .76, 'f5', .11], [537.75, 2.0, 'e5', .1],
  // the Helsinki thread
  [544.75, 2.4, '[a4,f5]', .11],
])
  .s('gm_celesta').gain(G * .75).room(.75).rsize(7).orbit(2)

// music box: brightens the training at the top; the solved third
$: line([
  ...scrub(510.39, 512.74, .25, .14).filter((e, k) => k % 2 === 0).map((e) => [e[0], e[1], e[2], e[3] * .55]),
  [514.19, 2.4, 'a5', .1],
])
  .s('gm_music_box').gain(G * .75).room(.6).rsize(5).orbit(2)

// ------------------------------------------------------------------ strings (low under the voice, warm in the gaps)
$: line([
  // Versailles: F arrives under the winter's D-A-E (F/A, then F)
  [448.567, 7.4, '[a2,f3,c4]', .07, { attack: 2.5, release: 1.5 }],
  [455.767, 5.6, '[f2,c3,a3]', .07, { attack: 1.5, release: 1 }],
  [461.267, 6.4, 'e5', .07, { attack: 1, release: 2.2 }],                         // ONE sustained high E
  // THE MESSENGER: a soft F bed through the long lines
  [485.19, 7.0, '[f2,c3]', .07, { attack: 2, release: 1 }],
  [492.19, 6.6, '[f2,c3,a3]', .07, { attack: 1, release: 1 }],
  [500.49, 7.5, '[d2,a2,f3]', .06, { attack: 1.2, release: 1 }],                // down the stairs: Dm
  [508.96, 3.9, '[bb1,f2]', .07, { attack: 1, release: .5 }],                // training: Bb -> C
  [512.69, 1.5, '[c2,g2]', .07, { attack: .4, release: .4 }],
  [514.19, 4.1, '[f2,c3,a3,f4,a4]', .1, { attack: .35, release: 1.3 }],          // SOLVED: the warm swell in the gap
  // the misty hills: the bold leap C -> F, landing warmly in the valley
  [533.09, .8, 'c4', .2, { attack: .25, release: .3 }],
  [533.89, 2.4, 'f4', .2, { attack: .3, release: 2.2 }],
  [533.89, 2.4, '[f2,c3,a3]', .16, { attack: .5, release: 2.2 }],
  // the study: the fall F -> E sits on C; a last soft F under Hinton's quote
  [536.99, 3.6, '[c3,g3]', .06, { attack: 1, release: 2 }],
  [550.75, 2.8, '[f2,c3]', .05, { attack: 1.2, release: 1.6 }],
], { attack: 1, release: 1.5 })
  .s('gm_string_ensemble_1').gain(G).lpf(1300).room(.7).rsize(7).orbit(3)

// bowed glass (written two octaves low): the error's rub; the fog
$: line([
  [499.04, 2.3, '[f3,gb3]', .07, { attack: .3, release: 1.4 }],                 // heard F5-Gb5
  [527.19, 6.4, '[g1,d2]', .07, { attack: 2, release: 1.6 }],                   // the fog (heard G3 D4)
  [527.19, 6.0, 'bb2', .04, { attack: 2.5, release: 1.6 }],                     // its minor colour, high and thin
], { attack: 1, release: 1.5 })
  .s('gm_pad_bowed').gain(G).lpf(4000).room(.7).rsize(6).orbit(4)

// ------------------------------------------------------------------ cello: the winter's D pedal; the sterile candle's colour
$: line([
  [470.367, 13.183, 'd2', .1, { attack: 2.5, release: 1.5 }],                       // the desks: the sterile candle's season
  [519.09, 4.67, '[d2,a2]', .11, { attack: 1.2, release: .2 }],                 // "The sterile extension"
  [523.76, 2.2, '[a1,e2]', .12, { attack: .1, release: 1.8 }],                  // gone: over A
  [527.19, 6.2, 'g1', .1, { attack: 2, release: 1.4 }],                         // the fog's root
], { attack: 1, release: 1.5 })
  .s('gm_cello').gain(G).lpf(700).room(.5).rsize(4).orbit(1)

// low clarinet: the sterile candle (D held, then C# on "seventeen"); the study
$: line([
  [519.89, 3.87, 'd4', .09, { attack: .5, release: .1 }],
  [523.76, 2.0, 'c#4', .12, { attack: .06, release: 1.4 }],
  [537.79, 5.0, 'f3', .1, { attack: 1.2, release: 1.2 }],                       // the study, low
  [546.99, 2.8, 'e3', .09, { attack: 1, release: 1.4 }],
], { attack: .3, release: 1 })
  .s('gm_clarinet').gain(G).lpf(1300).room(.45).rsize(4).orbit(5)

// ------------------------------------------------------------------ pizzicato: the desks' walk, the tugs, the footsteps
const deskWalk = []
{
  const keys = [['f2', 'a2', 'c3', 'a2'], ['g2', 'b2', 'd3', 'b2'], ['ab2', 'c3', 'eb3', 'c3'], ['f2', 'a2', 'c3', 'a2']]
  const at = [470.567, 475.19, 476.19, 481.17, 483.75]
  for (let d = 0; d < 4; d++) for (let t = at[d], k = 0; t < at[d + 1] - .05; t += B, k++) deskWalk.push([t, B * .8, keys[d][k % 4], .17])
}
$: line([
  ...deskWalk,
  // the messenger's tugs on each knob, and the blame
  [505.69, .5, 'c3', .22], [506.23, .5, 'a2', .2], [506.53, .5, 'f2', .22], [507.26, .5, 'c2', .2], [507.86, 1.0, 'f2', .26],
  // the misty hills: footsteps downhill, stalling in the hollow on an unresolved A
  ...['d3', 'c3', 'bb2', 'a2', 'g2', 'a2'].map((n, k) => [527.92 + k * .55, .5, n, .18 - k * .01]),
  // the threads: one pluck per lighting
  [543.56, .6, 'c3', .18], [543.99, .6, 'f3', .18], [544.39, .6, 'a3', .18], [544.75, 1.6, 'c4', .17],
], { release: .4 })
  .s('gm_pizzicato_strings').gain(G * .85).lpf(1400).room(.35).rsize(3).orbit(6)

// harp: the forward arpeggio's low doubling, the solved chord, the Helsinki thread
$: line([
  [492.31, .8, 'f2', .09], [492.65, .8, 'a2', .09], [493.05, .8, 'c3', .09], [493.5, 1.6, 'f3', .1],
  [514.19, 3.0, '[f2,c3,a3]', .1],
  [544.75, 2.4, '[f3,a3,c4]', .08],
])
  .s('gm_orchestral_harp').gain(G).release(2).lpf(2400).room(.55).rsize(5).orbit(6)

// the soft 1980s tick on the desks' offbeats (a short, high-passed noise)
$: line(deskWalk.map((e) => [e[0] + B / 2, .05, 'c3', .16]), { attack: .002, release: .03 })
  .s('white').decay(.03).sustain(0).hpf(7000).lpf(12000).orbit(7)

// the lamp's hum in the study (a very low sine)
$: line([
  [537.39, 15.6, 'c2', .5, { attack: 3, release: 2.5 }],
])
  .s('sine').gain(G * .03).lpf(200).orbit(8)
