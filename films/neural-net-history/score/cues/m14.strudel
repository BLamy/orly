// m14 — READ EVERYTHING (ch11 s01-s03). Window 1434.85–1491.00 s (56.15 s) on the 2139.54 s clock.
// candleAmber → serverCyan. Key: D major (the study), D mixolydian for the next-word machine (C natural: the
// machine's loose bVII). 88 BPM where there is a grid (beat .6818 s); cue-local seconds (absolute − 1434.85).
// RE-FIT (review round 1): ch11-s01 and ch11-s03 kept their shapes (+0.02 s / +2.24 s); ch11-s02 was re-narrated,
// so the piano's re-strikes now sit in the breaths of L1103 and the IV → I moved to "sensible … at the time".
// The join: m14 enters at 1434.85 (1.5 s fade-in) on m13's D, inside the 16.8 s speech-free gap before L1103.
//
//   0.00–14.23 (no narration: the film's structural cadence, V → I, the home key earned back after m13's A)
//              0.63 the dominant arrives under m13's ringing D6 (D held over A-E: the doubted candle, as in the slip);
//              2.35 → 3.03 M1's rising fourth A → D (cello + strings, celesta above) lands on D major on "pinC3d";
//              4.93 (recut) M3's TRAINED forward pass answers in celesta + harp, D F# A D, the bass climbing D-E-F#,
//              landing on the third (F#) over D/F# at 6.63: solved. The first time the two themes meet.
//              6.63–8.67 the peak: G(add9), the melody F# → G → A; 9.48 (library) A7sus4, 10.33 (machines) A7;
//              11.70 D: the arrival, celesta relighting A → D on top; the GPU pulse (16ths, lighter and quicker,
//              from the recut) follows the bass and thins away; everything settles by 14.2, before L1103.
//  14.23–44.03 SOLO PIANO: one D (D6 over a low D2 frame) under the 2019 quotation, re-struck only in its breaths
//              (before "read", before "predict the next word", before "every"); a kind IV → I (G → D): the G
//              under "sensible" (37.29), the D in the clear after "time" (38.72), left to ring through the gap.
//  44.03–56.15 THE NEXT-WORD MACHINE (M5): pulse D2 D3 A2 C3 locked to "pour" (45.43); one wooden tick per drawer;
//              in the temperature pause (47.43) it loosens to spread quarters, tightens on "set" (49.36) with a
//              chime, again (50.82); C/D lift on "No rulebook" (51.54), Dsus4 on "Only odds" (52.72); the pulse
//              stops half a second before the X-ray: one shimmer lands on a plain D chord (53.84), the last strike. m15 enters at
//              54.65 in D; the fade is 55.50–56.15.
// VOICE PASS (2026-10-11): the next-word machine (pulse, bass, C/D lift, chimes) about 3 dB softer under L1107,
//              which had measured 8 dB speech-to-music; the X-ray chord after 'odds' keeps its level.
const DUR = 56.15, BPM = 88
const VEL = 2.75         // global velocity scale (about -22 LUFS integrated)
// ---- seconds-based event compiler (shared by m13-m18) ----------------------------------------
// Events are [startSec, holdSec, notes, velocity, {per-event params}] in cue-local seconds. Each lane
// is compiled to one mini-notation sequence that spans SPAN seconds, then slowed to SPAN·cps cycles,
// so every onset lands exactly where the clock needs it, independent of the tempo grid.
const CPS = BPM / 240
setcps(CPS)
const SPAN = Math.ceil(DUR) + 4
const DFLT = { pan: .5, lpf: 18000, attack: .01, release: .3 }
const r4 = (x) => (Math.round(x * 10000) / 10000).toFixed(4)
function line(evs, defs) {
  defs = defs || {}
  const sorted = evs.filter((e) => e && e[0] < DUR).sort((a, b) => a[0] - b[0])
  const lanes = []
  for (const e of sorted) {
    let lane = lanes.find((l) => l.end <= e[0] + 1e-6)
    if (!lane) { lane = { end: 0, evs: [] }; lanes.push(lane) }
    lane.evs.push(e)
    lane.end = e[0] + e[1]
  }
  const keys = new Set(Object.keys(defs))
  for (const e of sorted) if (e[4]) for (const k of Object.keys(e[4])) keys.add(k)
  const seq = (lane, val) => {
    let pos = 0
    const out = []
    for (const e of lane.evs) {
      if (e[0] - pos > 1e-6) out.push('~@' + r4(e[0] - pos))
      out.push(val(e) + '@' + r4(e[1]))
      pos = e[0] + e[1]
    }
    if (SPAN - pos > 1e-6) out.push('~@' + r4(SPAN - pos))
    return mini('[' + out.join(' ') + ']')
  }
  return stack(...lanes.map((lane) => {
    let p = note(seq(lane, (e) => e[2])).velocity(seq(lane, (e) => r4(Math.min(1, e[3] * VEL))))
    for (const k of keys) p = p[k](seq(lane, (e) => (e[4] && e[4][k] != null ? e[4][k] : defs[k] != null ? defs[k] : DFLT[k] != null ? DFLT[k] : 0)))
    return p.slow(SPAN * CPS)
  }))
}
// a run of notes on a grid: from t0 (inclusive) to t1 (exclusive), one onset every `step` seconds,
// cycling through `notes`; vel may be a number or a function of (i, t); len = hold as a fraction of step
function run(t0, t1, step, notes, vel, len, params) {
  const out = []
  for (let i = 0, t = t0; t < t1 - 1e-6; i++, t = t0 + i * step) {
    const n = notes[i % notes.length]
    if (n === '~') continue
    const v = typeof vel === 'function' ? vel(i, t) : vel
    if (v <= 0) continue
    out.push([t, step * (len || 1), n, +v.toFixed(3), typeof params === 'function' ? params(i, t) : params])
  }
  return out
}
// ------------------------------------------------------------------------------------------------
const B = 60 / BPM, E = B / 2, S16 = B / 4
// ---- anchors (cue-local seconds, from narration/timeline.json) ----
const XRAY5 = 0.63, PIN = 3.03, RECUT = 4.93, LIBRARY = 9.48, MACHINES = 10.33, S02 = 14.23
// the cadence phrase (cue-local seconds; 88 BPM beats from the recut)
const P_FS = 6.63, P_G = 7.99, P_A = 8.67, HOME = 11.70
// the phrase's dynamics: building to the peak (6.6-9.5), then a diminuendo, so the arrival settles rather than
// climbs, and the study is quiet again by 14.2 (L1103 at 15.03). Applied to every voice of the opening.
const arc = (t) => (t < PIN ? .62 : t < P_FS ? .6 : t < LIBRARY ? .64 : t < MACHINES ? .52 : t < HOME ? .44 : t < S02 ? .36 : 1)
const shape = (evs) => evs.map((e) => (e && e[0] < S02 ? [e[0], e[1], e[2], +(e[3] * arc(e[0])).toFixed(4), e[4]] : e))
const READ = 21.05, PREDICT = 23.95, EVERY = 28.30, ANSWER_END = 31.05, TEAM = 33.55
const SENSIBLE = 37.29, TIME_END = 38.72
const M = 2.24                       // ch11-s03: the earlier grid, shifted onto the new "pour"
const POUR = 43.19 + M, TEMP = 45.19 + M, SET = 47.12 + M, AGAIN = 48.59 + M, NORULE = 49.30 + M, ODDS = 50.48 + M, XRAY = 51.60 + M

// ═══ CELESTA (sounds an octave above the written note) ═════════════════════════════════════════════════
$: line(shape([
  [PIN - .68, .6, 'a3', .12], [PIN, 1.6, 'd4', .15, { release: 2 }],         // M1 lit, softly doubled (sounding A4 → D5)
  // M3, TRAINED: forward D F# A D, landing on the third (sounding D5 F#5 A5 D6 → F#6)
  ...['d4', 'f#4', 'a4', 'd5'].map((n, i) => [RECUT + i * E, E, n, .17 + i * .02]),
  [P_FS, 2.0, 'f#5', .26, { release: 2.4 }],
  [P_A, 1.2, 'a4', .12], [P_A + B, 1.2, 'd5', .12],                             // a soft echo of the pass at the peak
  [HOME - .34, .34, 'a4', .16], [HOME, 2.2, 'd5', .22, { release: 3 }],          // M1 relit on the arrival (sounding A5 → D6)
  [SET, .9, '[a4,d5]', .06, { release: .8 }], [AGAIN, .9, '[a4,d5]', .06, { release: .8 }],   // the sort is set ... and again (soft: under the line)
]), { release: 1.4 }).s('gm_celesta').room(.65).rsize(4).orbit(3)

$: line([
  [SET, .9, 'd5', .045], [AGAIN, .9, 'd5', .045],                            // the chime's body (vibraphone ≤ C6 written range is safe at D5)
]).s('gm_vibraphone').release(2).room(.6).rsize(4).orbit(3)

// harp: the arrival's roll, the forward pass an octave below, the home chord
$: line(shape([
  ...['d2', 'a2', 'd3', 'f#3', 'a3'].map((n, i) => [PIN + i * .07, 1.8, n, .13]),
  ...['d3', 'f#3', 'a3', 'd4'].map((n, i) => [RECUT + i * E, E, n, .12]), [P_FS, 1.6, 'f#4', .15],
  ...['d2', 'a2', 'd3', 'f#3', 'a3', 'd4'].map((n, i) => [HOME + i * .06, 2.0, n, .12]),
]), { release: 1.8 }).s('gm_orchestral_harp').room(.55).rsize(4).orbit(4)

// the X-ray: one shimmer (music box, kept at or below A6) landing on a glassy D with the chord
$: line([
  [XRAY - .18, .06, 'd6', .09], [XRAY - .12, .06, 'f#6', .09], [XRAY - .06, .06, 'a6', .09], [XRAY, 1.5, 'd6', .1],   // after "odds"
]).s('gm_music_box').release(1.8).room(.7).rsize(5).orbit(3)
$: line([[XRAY, 2.2, '[d6,a6]', .06, { attack: .4, release: 1.8 }]]).s('gm_pad_bowed').lpf(6000).room(.6).orbit(3)

// ═══ STRINGS ══════════════════════════════════════════════════════════════════════════════════════════
$: line(shape([
  [XRAY5, 2.3, '[a2,e3]', .09, { attack: 1.4, release: .6 }],               // the dominant under m13's D: Asus4
  [PIN, 1.9, '[d3,f#3,a3]', .14, { attack: .25 }],                            // ... home: D
  [RECUT, .68, '[d3,f#3,a3]', .15, { attack: .2 }], [RECUT + 2 * E, 1.36, '[e3,g3,b3]', .16, { attack: .25 }],   // D → Em7 (bass E)
  [P_FS, 1.36, '[a3,d4]', .19, { attack: .2 }],                                // D/F#: the trained pass lands on the third
  [P_G, 1.49, '[d3,g3,b3]', .21, { attack: .25 }],                            // the peak: G(add9) under the melody's A
  [LIBRARY, .85, '[d3,e3,g3]', .17, { attack: .2 }],                          // A7sus4
  [MACHINES, 1.37, '[c#3,e3,g3]', .15, { attack: .2 }],                       // A7
  [HOME, 2.0, '[d3,f#3,a3,d4]', .15, { attack: .15, release: 1.8 }],          // D: home, earned back
  // the melody (first violins): M1's rising fourth, then the line the trained pass sings under
  [PIN - .68, .66, 'a3', .14, { attack: .12, lpf: 2200 }], [PIN, 2.58, 'd4', .17, { attack: .1, lpf: 2200 }],
  [RECUT + 2 * E, 1.0, 'e4', .17, { attack: .15, lpf: 2200 }], [P_FS, 1.36, 'f#4', .22, { attack: .15, lpf: 2400 }],
  [P_G, .68, 'g4', .23, { attack: .12, lpf: 2400 }], [P_A, 1.66, 'a4', .25, { attack: .12, lpf: 2400 }],
  [MACHINES, 1.37, 'g4', .19, { attack: .15, lpf: 2200 }], [HOME, 2.2, 'f#4', .17, { attack: .15, release: 1.8, lpf: 2200 }],
  [S02 + .1, 14.0, '[d6]', .025, { attack: 3, release: 2, lpf: 6000 }],      // a thread of high D: the flame, very faint
  [TIME_END, 5.0, '[d3,f#3,a3]', .1, { attack: 1.5, release: 1.5 }],         // the D of "time", carried through the gap
  [POUR - .79, 6.9, '[d3,a3]', .07, { attack: 1.5, release: .8 }],
  [NORULE, 1.18, '[c3,e3,g3]', .08, { attack: .25, release: .8 }],           // "No rulebook": C/D, a lift
  [ODDS, .55, '[d3,g3,a3]', .075, { attack: .3, release: .2 }],              // "Only odds": Dsus4
  [XRAY, 1.0, '[d3,f#3,a3]', .12, { attack: .08, release: 2.5 }],             // the X-ray: plain D
]), { attack: 1, release: 1.5, lpf: 1300 }).s('gm_string_ensemble_1').hpf(120).room(.6).rsize(4).orbit(2)

// ═══ CELLO: M1's rising fourth an octave below the violins, then the bass line's warmth ══════════════════
$: line(shape([
  [PIN - .68, .66, 'a2', .15, { attack: .1 }], [PIN, 2.6, 'd3', .17],
  [RECUT + 2 * E, 1.36, 'e3', .14], [P_FS, 1.36, 'f#3', .15], [P_G, 1.49, 'g3', .16],
  [LIBRARY, .85, 'a2', .15], [MACHINES, 1.37, 'a2', .14], [HOME, 2.2, 'd3', .14, { release: 1.6 }],
]), { attack: .2, release: 1.2 }).s('gm_cello').lpf(1600).hpf(50).room(.45).rsize(3).orbit(1)

// ═══ CONTRABASS ══════════════════════════════════════════════════════════════════════════════════════
$: line(shape([
  [XRAY5, 2.3, 'a1', .15, { attack: 1.2, release: .5 }],                     // V ...
  [PIN, 2.6, 'd2', .21, { attack: .1 }],                                      // ... I
  [RECUT + 2 * E, 1.36, 'e2', .2], [P_FS, 1.36, 'f#2', .22], [P_G, 1.49, 'g2', .23],
  [LIBRARY, .85, 'a1', .21], [MACHINES, 1.37, 'a1', .2],
  [HOME, 2.4, 'd2', .21, { release: 1.8 }],
  [S02 + .1, 6.7, 'd2', .1, { attack: 2.5 }], [READ, 7.0, 'd2', .09, { attack: 2 }], [EVERY, 5.0, 'd2', .08, { attack: 2 }],
  [TEAM, 3.6, 'd2', .08, { attack: 2, release: 1 }],
  [SENSIBLE, 1.4, 'g1', .12, { attack: .6 }],
  [TIME_END, 5.0, 'd2', .16, { attack: .6 }],
  [POUR - .79, 6.9, 'd2', .09, { attack: 1, release: .6 }],
  [NORULE, 1.18, 'c2', .10, { attack: .2, release: .5 }], [ODDS, .6, 'd2', .10, { attack: .2, release: .2 }],
  [XRAY, 1.0, 'd2', .17, { attack: .05, release: 2.4 }],
]), { attack: .8, release: 1.4 }).s('gm_contrabass').lpf(380).hpf(40).room(.3).rsize(3).orbit(1)

// ═══ SOLO PIANO: the one D under the quotation (re-struck in its breaths); sensible … at the time (IV → I) ═══
$: line([
  [S02 + .27, 6.4, '[d2,d6]', .2], [READ, 2.8, 'd6', .14], [PREDICT, 4.2, '[d2,d6]', .16], [EVERY, 2.7, 'd6', .13],
  [ANSWER_END, 2.4, 'a5', .1], [TEAM, 3.6, 'd6', .09],
  [SENSIBLE, 1.4, '[g2,d3]', .12], [TIME_END, 3.5, '[d2,a2,f#3,d4]', .19, { release: 3.5 }],
  [XRAY, 1.6, '[d2,a2,d3,f#3,a3]', .13, { release: 2.4 }],                            // the X-ray: a plain D, the last strike
], { release: 3 }).s('piano').lpf(3000).room(.55).rsize(4).orbit(7)

// ═══ THE PULSE (oscillator): lighter and quicker in the study; the next-word machine in D mixolydian ═════
$: line(shape([
  // lighter and quicker (16ths) from the recut, following the bass; it thins away after the arrival
  ...run(RECUT, 13.4, S16, ['r', 'o', 'f', 'o'], (i, t) => (i % 4 === 0 ? .2 : .1) * (t < P_FS ? .8 : t < MACHINES ? 1 : Math.max(0, 1 - (t - MACHINES) / 2.6)), .6)
    .map((e) => { const r = e[0] < RECUT + 2 * E ? ['d2', 'd3', 'a2'] : e[0] < P_FS ? ['e2', 'e3', 'b2'] : e[0] < P_G ? ['f#2', 'f#3', 'd3'] : e[0] < LIBRARY ? ['g2', 'g3', 'd3'] : e[0] < HOME ? ['a1', 'a2', 'e2'] : ['d2', 'd3', 'a2'];
      e[2] = { r: r[0], o: r[1], f: r[2] }[e[2]]; return e }),
  ...run(POUR, TEMP, E, ['d2', 'd3', 'a2', 'c3'], .115, .6),
  ...run(TEMP, SET, B, ['d2', 'a2', 'c3', 'd3'], .095, .5),                    // the temperature pause: loose
  ...run(SET, XRAY - .5, E, ['d2', 'd3', 'a2', 'c3'], (i) => (i % 4 === 0 ? .115 : .085), .6),
])).s('sawtooth').lpf(560).hpf(40).decay(.18).sustain(0).gain(.32).room(.2).orbit(5)

// ═══ WOOD: one tick per drawer as it slides ══════════════════════════════════════════════════════════
$: line([
  ...[0, .34, .68, 1.02, 1.20].map((d) => [POUR + d, .1, 'd6', .055]),
  ...run(SET, XRAY - .5, B, ['a5'], .035, .5),
]).s('gm_woodblock').room(.2).orbit(6)
