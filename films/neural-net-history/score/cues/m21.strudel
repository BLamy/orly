  [A(2059.35), .14, 'd3', .24], [A(2059.49), .14, 'f#3', .25], [A(2059.63), .14, 'a3', .26], [A(2059.77), .14, 'd4', .27],
  [A(2059.91), 1.14, '[d3,a3,d4,f#4,a4,d5,f#5]', .22, { attack: .18, release: .3 }],
], { attack: .05, release: .3 })
  .s('gm_string_ensemble_1').lpf(3600).room(.4).rsize(2.5).orbit(8)
// horns: the warm middle of the chord (the film's only brass), the third on top
$: line([[A(2059.91), 1.14, '[d3,a3,f#4]', .24]], { attack: .22, release: .3 })
  .s('gm_french_horn').lpf(2400).room(.4).rsize(2.5).orbit(8)
// harp: the forward pass rolled once more up the chord as it lands
$: line([
  [A(2059.91), 1.1, 'd3', .22], [A(2059.95), 1.06, 'a3', .22], [A(2059.99), 1.02, 'd4', .22],
  [A(2060.03), .98, 'f#4', .22], [A(2060.07), .94, 'a4', .22], [A(2060.11), .9, 'd5', .24],
], { release: .5 }).s('gm_orchestral_harp').room(.4).rsize(2.5).orbit(8)
// one soft timpani stroke on the landing (the score's restrained percussion)
$: line([[A(2059.91), 1.0, 'd2', .32]], { release: .6 }).s('gm_timpani').lpf(1200).room(.35).rsize(2.5).orbit(8)

