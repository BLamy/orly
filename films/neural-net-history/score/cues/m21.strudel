  [A(2086.451), 1.14, '[d3,a3,d4,f#4,a4,d5,f#5]', .22, { attack: .18, release: .3 }],
], { attack: .05, release: .3 })
  .s('gm_string_ensemble_1').lpf(3600).room(.4).rsize(2.5).orbit(8)
