  [A(2086.571), .98, 'f#4', .22], [A(2086.611), .94, 'a4', .22], [A(2086.651), .9, 'd5', .24],
], { release: .5 }).s('gm_orchestral_harp').room(.4).rsize(2.5).orbit(8)
