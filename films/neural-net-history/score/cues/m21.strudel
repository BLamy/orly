// SOLO CELESTA (sounds an octave above the written note): the wick (the fifth flash), "Learning", the wave's
// first column (a third) and its ticking ostinato (a third), the trained pass's F#, the bar chart in wax,
// the last slip, the last gesture.
const osc = []
for (let t = A(2082.561); t < A(2085.741); t += .25) osc.push([t, .25, Math.round((t - A(2082.561)) / .25) % 2 ? 'd5' : 'a4', .11 * W3 * WH * (t > A(2084.84) ? .45 : 1)])   // v6: -2 dB; v8: under 'all along'
// the ticking thins by 7 dB (its A5 left 'all' 1.6 dB clear in 1-4 kHz) so the bloom's pickup arrives from near-silence
$: line([
  [A(2069.961), .8, '[d4,a4]', .13, { release: 1.2 }],   // v5: decayed before 'Who'
  [A(2075.411), .48, 'a3', .17, { release: .4 }], [A(2075.891), .4, 'd4', .17, { release: .6 }],   // v6: the A in the breath, the D struck on
  // 'Learning' and let go at once (v5's 1.6-s D, sounding D5, rang under 'with its accomplices': ~0 dB clear in 250-2k); the halo holds it
  [A(2082.001), .11, 'd4', .2 * W3 * WH], [A(2082.111), .11, 'f#4', .2 * W3 * WH], [A(2082.221), .11, 'a4', .2 * W3 * WH], [A(2082.331), .2, 'd5', .2 * W3 * WH],   // v6: -2.3 dB
  ...osc,
  [A(2086.451), 1.14, 'f#4', .27, { release: .9 }],          // the bloom's top F# (v4); v6: released by 2083.5, not into 'Some candles'
  [A(2089.341), 1.0, 'd4', .085, { release: 1.2 }],        // "forty": its length is the contrabass's low D2 (v6: the celesta's 5-s
  // ring, sounding D5, sat under 'years, some two': 2 dB clear in the vowel band)
  [A(2091.011), .25, 'a4', .1, { release: .35 }],          // "two": short (v6: -3 dB, damped)
  [A(2093.031), .1, 'd5', .1, { release: .12 }],          // "one match, a day": the shortest tick (v8: -3.5 dB, 'day' was 3.0 clear)
  [A(2094.211), 1.4, 'd4', .16, { release: 2 }],         // "The newest still burn": a held D, still lit (v5: gone before 'One lantern')
  [A(2108.760), .4, 'a3', .15, { release: .6 }], [A(2109.250), .3, 'd4', .14, { release: .8 }],   // the last slip (v8): the A an upbeat out of
  // the held E, the D struck ON the cut to the wall, 0.8 s before 'The' (v7's A on the cut and D 0.31 s before 'The' left
  // the word -0.8 dB in 250-2k);
  // the celesta lets go almost at once (v5: L1517's 250-2k band was 2.4 dB clear of its ring); the strings wait for 'seventeen'
  // v6: the wick catches on 'candles': one tiny, damped glint pinned to the word (sounding A5, far below the
  // statement); the statement itself, A -> D slowed, whole in the clear 0.14 s after 'from' ends, as the
  // flame stands; the D held
  [A(2131.350), .15, 'a4', .05, { release: .4 }],
  [A(2132.430), .7, 'a3', .34, { release: 3 }], [A(2133.130), 3, 'd4', .38, { release: 7 }],       // the new candle
], { release: 1.4 })
  .s('gm_celesta').room(.7).rsize(5).orbit(4)

// HARMONY: low strings + contrabass. D under "Learning"; the network's floor (soft); the bloom; then the slip's
