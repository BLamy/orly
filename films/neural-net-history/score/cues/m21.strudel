// ---- THE LAST CHORD (v3): as the strings and contrabass slide to A-E, a solo cello takes the held D in the middle
// register (D3), so the suspension is in the body of the chord, not only in the decaying celesta: Asus4 with D in
// three octaves (cello D3, celesta D5 sounding, strings D5). In the clear (after 'come from'); never resolves. ----
$: line([[A(2134.780), 3.2, 'd3', .24]], { attack: 1.3, release: 6 })
  .s('gm_cello').lpf(1100).room(.8).rsize(6).orbit(9)

// ---- M4's walk: solo cello below D3, very soft (someone at the rim is suspicious) ----
$: line([
  // v8: -1.4 dB (L1520 80-250 Hz was 7.9 dB clear). Fitted to L1520: G2 on 'rim', home on D before 'That' ... gone by the match strike on 'new'
  [A(2125.530), .5, 'a1', 0.170], [A(2126.030), .95, 'd2', 0.178], [A(2126.980), .5, 'e2', 0.170],
  [A(2127.480), .95, 'f2', 0.178], [A(2128.450), .5, 'g2', 0.170], [A(2128.950), .5, 'f2', 0.162],
  [A(2129.450), .45, 'e2', 0.162], [A(2129.900), .5, 'c2', 0.153], [A(2130.400), .6, 'd2', 0.145, { release: .6 }],
], { attack: .15, release: .8 })
  .s('gm_cello').hpf(45).lpf(800).room(.45).rsize(3).orbit(3)

// ---- THE SUSPENSION KEPT ALIVE UNDER THE END CARDS (v6, re-fitted v8 to the 28.71-s ch15-s10). After the new-candle
// Asus4 has bloomed and begun to decay, a ppp string pad takes over the same notes (the A-E fifth below, the D above
// it) behind lpf 1200, entering under the chord's own release so there is no seam; it holds through the Turing card
// (b1-b2), thins to the D alone under the CREDITS card (from b2: the fifth released) and HOLDS it there, and lets go
// on SOURCES, ringing down to the room-tone floor before the fade (b3). One soft celesta D, the candle's own note,
// on SOURCES. No cadence: the D never moves to C#, the A-E never moves to D. ----
const B1 = 2135.792, B2 = 2143.792, SRC = 2156.592   // ch15-s10 beats b1, b2, sources (shot 2135.2917 + 0.5 / 8.5 / 21.3)
$: line([
  [A(B1 + 1.038), 6.8, '[a1,e2]', .095, { attack: 3, release: 2.2 }],   // the fifth, let go into b2: the CREDITS card
  // settles on the D alone within its first two seconds
], { attack: 3, release: 3 })
  .s('gm_string_ensemble_1').hpf(40).lpf(700).room(.7).rsize(6).orbit(10)
$: line([
  [A(B1 + 1.038), 7.15, '[d3,d4]', .075, { attack: 3, release: 2.5 }],   // the suspended D, middle and above (the cello's D3, the celesta's D)
  [A(B2 - .482), 7.0, 'd3', .13, { attack: 2.5, release: 3.5 }],         // the D ALONE, bowed under b2 and held (review r3: about -34 M, never
  // a decay to -40, which reads as silence)
  [A(B2 + 5.508), SRC - B2 - 5.2, 'd3', .12, { attack: 3, release: 4.5 }],   // v8: the second bowing, crossfading in halfway through the
  // 12.8-s CREDITS card so the D does not sag; held 0.3 s past SOURCES, then let go with the celesta
  [A(B2 + 5.508), SRC - B2 - 5.2, 'd4', .04, { attack: 3.5, release: 4 }],   // v8: a faint upper octave on that bowing: the flame breathes once
], { attack: 3, release: 3 })
  .s('gm_string_ensemble_1').lpf(1200).room(.7).rsize(6).orbit(10)
$: line([[A(SRC), 1.2, 'd4', .09, { release: 4 }]], { release: 4 })  // SOURCES: the candle's D (sounding D5), once: the last strike
  .s('gm_celesta').room(.75).rsize(6).orbit(10)
