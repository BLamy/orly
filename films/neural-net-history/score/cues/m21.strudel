$: line([
  [A(2075.891), 5.8, '[d5,f#5,a5]', .02, { attack: 1.2, lpf: 1800 }],   // v5: a halo, not a bed
  [A(2084.631), .45, '[a5,d6]', .1 * W3 * WH, { attack: .3, release: .35 }],   // v8: a glint on 'network', gone before 'all'
  // (held through 'all along' its A5/D6 left 'all' 2-3 dB clear in 1-4 kHz)
  [A(2094.211), 2.0, 'd5', .05, { attack: .8, release: 1 }],
  [A(2096.891), 7.35, 'e5', .045, { attack: 1.5, release: .6 }],    // v5: -3.7 dB under L1516/L1516b; v8: a further -3 dB ('open' 1.8 dB
  // clear in 1-4 kHz of its B6/E6 harmonics); the piano and glass carry the E, the re-bow in the clear restores it
  [A(2104.241), 4.65, 'e5', .1, { attack: 1.2, release: 1.5 }],      // v5: re-bowed in the clear after 'That file stays open':
                                                                     // the question carries the hold to the cut at full v4 level, unanswered
  [A(2114.700), 5.5, 'd5', .045, { attack: 1.8, release: 1.2 }],   // v7: the slip's D taken up after 'back in twenty
  // seventeen' (L1517 bare), in the breath before the quote; held through it, gone before the stamp (b3)
  [A(2133.130), 3.5, 'd5', .083, { attack: 1.2, release: 6 }],
], { attack: 1, release: 2, lpf: 2600 })
  .s('gm_string_ensemble_1').room(.7).rsize(6).orbit(6)

// ---- THE NETWORK: M3's forward wave, one era instrument per column, all at a third under the line;
// anything between D3 and D5 behind lpf 900 ----
const rip = (t, ns, v) => ns.map((n, i) => [A(t) + .11 * i, i === 3 ? .2 : .11, n, v * W3])
// valve organ (low, its top D3 filtered), then its held fifth
$: line([...rip(2082.441, ['d2', 'f#2', 'a2', 'd3'], .22), [A(2082.881), 2.9, '[d2,a2]', .15 * W3, { attack: .3, release: .5 }]], { release: .3 })
  .s('gm_drawbar_organ').lpf(700).room(.4).rsize(3).orbit(7)   // v5: lpf 900 -> 700 (its upper partials sat in 1-4 kHz)
// cello (low), then its held A
$: line([...rip(2082.881, ['a1', 'd2', 'f#2', 'a2'], .24), [A(2083.321), 2.45, 'a2', .16 * W3, { attack: .2, release: .5 }]], { release: .4 })
  .s('gm_cello').lpf(900).room(.4).rsize(3).orbit(7)
// piano (high), then soft high pings
$: line([...rip(2083.321, ['d5', 'f#5', 'a5', 'd6'], .2 * WH), [A(2083.861), .5, 'f#6', .12 * W3 * WH], [A(2084.361), .5, 'a6', .12 * W3 * WH], [A(2084.861), .4, 'f#6', .065 * W3 * WH]], { release: .6 })   // v8: the 'along' A6 dropped, the F#6 halved
  .s('piano').room(.5).rsize(3).orbit(7)
// the GPU-era oscillator pulse (low eighths, its D3 filtered), stopping as the line ends
const pulse = []
for (let i = 0; i < 9; i++) pulse.push([A(2083.761) + .22 * i, .2, ['d2', 'd3', 'a2', 'd3'][i % 4], .5])
$: line(pulse).s('sawtooth').lpf(900).attack(.005).decay(.18).sustain(0).release(.05).gain(.16 * W3).orbit(7)
// harp (high)
$: line([...rip(2084.201, ['d5', 'f#5', 'a5', 'd6'], .24 * WH), [A(2084.861), .4, 'a5', .07 * W3 * WH, { release: .6 }]], { release: 1.5 })   // v8: the 'along' D6 dropped, the A5 halved
  .s('gm_orchestral_harp').room(.5).rsize(3).orbit(7)
// pizz (low, its D3 filtered) on "network"
$: line([...rip(2084.631, ['d2', 'f#2', 'a2', 'd3'], .32), [A(2085.151), .3, 'd2', .26 * W3], [A(2085.551), .2, 'a1', .22 * W3]], { release: .4 })
  .s('gm_pizzicato_strings').lpf(900).room(.4).rsize(3).orbit(7)

