  [BEND, 3.3, '[f3,a3,c4,e4]', .14, { attack: 1, release: 2 }],               // the lift (gap 24.59–27.30)
  [LUNCH + .6, 2.9, '[a4,c5,e5]', .035, { lpf: 1700 }], [LUNCH + 3.5, 1.9, '[g4,c5,e5]', .035, { lpf: 1700 }], [LUNCH + 5.4, 1.5, '[f4,a4,c5]', .035, { lpf: 1700 }],
  [DOUBT, 8.1, '[b2,e3]', .07, { attack: .6, release: .9 }],                    // DOUBTED: E-B under the held A
  [DOUBT, 8.1, 'a5', .065, { attack: .8, release: .9, lpf: 1900 }],            // the flame (A), unmoved, above the voice
  [ONCE, .9, '[a4,c#5,e5,a5]', .028, { attack: .25, release: 1.0, lpf: 2600 }],
