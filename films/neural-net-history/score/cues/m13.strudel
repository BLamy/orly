  [A1 + 44.57, 2.66, '[e3,a3,c#4]', .055], [A1 + 47.23, 2.67, '[f#3,a3,c#4]', .055],
  [A1 + 49.90, 2.67, '[f#3,a3,d4]', .055], [A1 + 52.57, 2.4, '[e3,g#3,b3]', .10, { attack: .9, release: 2 }],
  [ALLCARDS - .2, 1.6, '[e3,a3,c#4]', .10, { attack: .6, release: 1.4 }],     // under the M3 forward pass (no drone under the cards)
  [EDGE + .15, .35, '[d3,f#3,a3]', .05, { attack: .2, release: .4 }],          // IV (on "edge", soft) ...
  [EDGE_END, 1.6, '[e3,a3,c#4,e4]', .14, { attack: .3, release: .9, lpf: 1800 }],   // ... I: "water's edge", in the gap
  [SOFT, 6.8, '[e3,a3,c#4]', .055, { attack: 1.2, release: 1.2, lpf: 1100 }],             // warmer: it pours softly
  [GLOW, 3.9, '[a2,e3,a3,c#4,e4,a4]', .16, { attack: .25, release: 1.4, lpf: 2400 }],  // the hall glows
  [GLOW, 3.9, '[c#6,e6]', .12, { attack: .4, release: 1.4, lpf: 4000 }],
  [SHUFFLE - .2, 12.6, '[e3,a3]', .055, { attack: 1.5, release: 1 }],         // shuffle + clocks' held chord
  [BLK + 142.30, 4.3, '[e3,a3]', .11, { attack: 1.5, release: .8 }],         // the lane
  [MAT + 146.60, 5.6, '[e3,a3,c#4]', .05, { attack: 1.5, release: .3 }],
  [UNISON, 3.2, '[a2,a3]', .05, { attack: .03, release: 1 }],                  // UNISON
  [UNISON, 2.2, '[a5,a6]', .025, { attack: .1, release: 1, lpf: 3500 }],
  [IV_, 1.3, '[d3,f#3,a3,d4,f#4]', .21, { attack: .15 }],                          // cadence in the gap: IV ...
  [V_, 1.2, '[e3,g#3,b3,e4,g#4]', .175, { attack: .1 }],                           // ... V ...
  [RECORDS, .6, '[a2,e3,a3,c#4,e4]', .16, { attack: .05, release: .7, lpf: 2000 }],  // ... I on "records"
  // M1 IN FULL, high and thin over a low E-B, as the read-in-order candle goes out:
  // E→A lit on candleOut, A held while E-B slides under (doubted), A→G# on "two" (gone)
  // review round 2: it is HEARD now. LIT in the clear after "looking" (E→A over A major), the suspension arriving on
  // the cut to the candle (E-B slides under the held A), the line rides over a thin low E-B and a pp A, and the
  // fall (A→G#, E major: the half-cadence) lands in the clear after "two years", under the honest card.
  [LIT - .3, .3, 'e5', .15, { attack: .07, release: .3, lpf: 2400 }],
  [LIT, CUT_OUT - LIT + .25, 'a5', .16, { attack: .12, release: .45, lpf: 2400 }],
  [LIT, CUT_OUT - LIT, '[a2,e3,a3,c#4]', .13, { attack: .3, release: .5 }],
  [CUT_OUT, L1030_ON - CUT_OUT - .05, '[e3,b3]', .11, { attack: .25, release: .35 }],
  [CUT_OUT, LINE_END - CUT_OUT, '[e2,b2]', .07, { attack: .3, release: .6 }],
  [L1030_ON - .25, LINE_END - L1030_ON + .25, 'a5', .035, { attack: .5, release: .4, lpf: 1600 }],
  [LINE_END + .19, 1.8, 'g#5', .15, { attack: .1, release: 1.8, lpf: 2200 }],
  [LINE_END + .19, 1.8, '[e2,b2,e3,g#3]', .10, { attack: .2, release: 1.8 }],
  // THE CURTAIN: a slow A – F#m – D – E under the two lines, then nothing beneath the D
  [CURTAIN + .5, 6.1, '[e3,a3]', .06, { attack: 2 }], [CURTAIN + 6.6, 4.8, '[f#3,a3]', .055, { attack: 1.2 }],
  [CURTAIN + 11.4, 5.5, '[f#3,a3]', .055, { attack: 1.2 }], [CURTAIN + 16.9, 3.4, '[e3,g#3,b3]', .055, { attack: 1, release: .6 }],
], { attack: .8, release: 1.5, lpf: 1300 }).s('gm_string_ensemble_1').hpf(150).room(.6).rsize(4).orbit(2)

// ═══ CELESTA (sounds an octave above the written note) ═════════════════════════════════════════════════
const heads = ['e4', 'a4', 'c#5', 'e5', 'f#5', 'g#5', 'a5', 'b5']     // written: sounding E5 A5 C#6 E6 F#6 G#6 A6 B6
$: line(uv([
  // THE SLIP MOTIF (m12's pitches, as m21 resolves them): A→D landing on slipPinned; again, softer, on the draught
  [SLIP - .25, .25, 'a3', .34, { release: 1.2 }], [SLIP, 1.0, 'd4', .36, { release: 2.2 }],
  [DRAUGHT - .25, .25, 'a3', .21, { release: 1.2 }], [DRAUGHT, 2.4, 'd4', .22, { release: 2.6 }],
  // LUNCH: the high half of the conversation
  ...run(LUNCH + .16 + 4 * E, DOUBT - .3, E, ['e5', '~', 'c5', '~', '~', '~', '~', '~', 'd5', '~', 'b4', '~', '~', '~', '~', '~'], .12, 1),
  // ALL AT ONCE: struck with the chord, then a soft high ostinato (A E C# E) locked to the downbeat
  [ONCE, 1.2, '[a4,c#5,e5]', .09, { release: .9 }],
  ...run(A1 + 44.57, A1 + 54.2, E, ['a4', 'e5', 'c#5', 'e5'], (i, t) => (i % 4 === 0 ? .11 : t > 52.55 && t < 54.55 ? 0 : .08), 1),  // downbeats only under the paper's title
  // THREE CARDS: one bell per card on its word (sounding E6 / C#6 / A5: above the voice), soft
  [Q, 2.3, 'e5', .16, { release: 2.5 }], [K, 2.0, 'c#5', .15, { release: 2.5 }], [V, 2.2, 'a4', .14, { release: 2.5 }],
  // M3 forward after "messenger" (in the clear: A C# E A), landing on the third (C#) on allCards
  [MSG_END + .05, .3, 'a3', .2], [MSG_END + .31, .3, 'c#4', .2], [MSG_END + .57, .3, 'e4', .22], [MSG_END + .83, .5, 'a4', .24],
  [ALLCARDS, 1.0, 'c#5', .26, { release: .6 }],
  // THE JUG: the high figure only in the breaths of L1011 (before "Four", after "bank", "label", "way")
  [JUG + .05, .35, 'a4', .06, { release: .35 }], X([80.95, .3, 'e5', .07, { release: .5 }]), X([83.40, .3, 'c#5', .07, { release: .5 }]), X([85.83, .3, 'e5', .07, { release: .5 }]),
  // the jug pours: falling arpeggios through A – D – F#m – E, all sounding A5 and above, landing after "river"
  ...['e6', 'c#6', 'a5', 'e5', 'f#6', 'd6', 'a5', 'f#5', 'e6', 'c#6', 'a5', 'f#5', 'e6', 'b5', 'g#5', 'e5']
    .map((n, i) => [POUR + .3 + i * (5.0 / 16), .4, n, +(.10 - i * .002).toFixed(3)]),
  [RIVER, 1.0, '[a4,c#5,e5]', .07, { release: .8 }],                           // the cup fills on "river" (under the line: uv)
  ...['e6', 'c#6', 'a5', 'e5'].map((n, i) => [MESSAGES + i * .25, .3, n, .07]),   // a second, smaller pour, very high
  [EDGE_END + .03, 1.8, 'c#5', .14],                                          // the top of "water's edge"
  // DIVIDE BY EIGHT: the arpeggio, then it jams on one note (slam), then nothing (freeze)
  ...run(DIV + .3, SLAM - .1, E, ['a4', 'c#5', 'e5', 'c#5'], .08, 1, (i, t) => (t > 112.2 + SH ? { release: .45 } : undefined)),
  // the jam: a 0.6 s stuck burst from "tips", stopping well before "cup" (the freeze lands after the line)
  ...run(SLAM, SLAM + .6, S16, ['e5'], (i) => .058 - .009 * i, 1, { release: .2 }).map(X),
  X([HALVED_END, .28, 'e5', .17]), X([HALVED_END + .28, 1.2, 'a5', .19]),    // the bright tag after "so we halved" (round 2: in the clear)
  // EIGHT HEADS (voices 0, 2, 4, 6 here; 1 on vibraphone, 3, 5, 7 on music box below)
  ...[0, 2, 4, 6].flatMap((k) => run(EIGHT + k * .45, GLOW + 3.8, B, [heads[k]], (i, t) => (t > HD + 127.5 ? .06 : t < GLOW - .05 ? .07 : .12), 1, { pan: +(.12 + k * .108).toFixed(3) })),
  // CLOCKS: under "shuffle", a four-note figure and its shuffle (same notes, same sum), very soft
  ...['e4', 'c#5', 'a4', 'e5', 'a4', 'e5', 'c#5', 'e4'].map((n, i) => [SHUFFLE + .1 + i * B, B, n, .07]),
  ...['e4', 'c#5', 'a4', 'e5'].map((n, i) => [SHUFFLE + 5.0 + i * B, B, n, .06]),
  // the minute hand (one note every two beats) from "clock"
  ...run(CLOCK, 150.2 + SH, 2 * B, ['e5', 'c#5'], .10, 1, { pan: .7 }),
  // SIX BLOCKS: "think" = one held note, a step higher each time (sounding A5 B5 C#6 D6 E6 F#6)
  ...['a4', 'b4', 'c#5', 'd5', 'e5', 'f#5'].map((n, r) => [BLK + 138.40 + r * 2 * B + B, B * 1.2, n, .15 + r * .015, r > 3 ? { release: .45 } : undefined]),
  // THE MATRIX: the heads return scattered, then everything converges on A
  ...[0, 2, 4, 6].flatMap((k) => run(MAT + 148.60 + k * .27, UNISON - .19, B, [heads[k]], .05, 1, { pan: +(.12 + k * .108).toFixed(3) })),
  [UNISON, 1.2, '[a4,a5]', .055],
  ...run(UNISON + E, MAT + 155.6, E, ['a4'], (i) => .08 - i * .006, 1),
  [RECORDS, .8, '[e4,a4,c#5]', .12, { release: .8 }],
  // THE CURTAIN: the typesetter's tap on C# (sounding C#6), thinning under the second line ... and on
  // "next" it steps up to D (sounding D6), over nothing
  ...run(CURTAIN + .6, 203.4 + SH, B, ['c#5'], .09, .5),
  ...run(204.0 + SH, NEXT - 1.0, 2 * B, ['c#5'], .08, .5),
  X([NEXT, .45, 'c#5', .07]), X([NEXT_END, 3.0, 'd5', .19, { release: 3.6 }]),  // round 2: C# on "next", the step to D just after it
], .4), { release: 1.4 }).s('gm_celesta').room(.65).rsize(4).orbit(3)

// ═══ DRY CELESTA: the worked numbers, placed in the micro-gaps of L1012, short and nearly dry so nothing rings
// into the next number ("two, nothing, four, two" = sounding F#6 D6 A6 F#6; halved: an octave lower, after "them")
$: line([
  [N1, .3, 'f#5', .05], [N2, .26, 'd5', .046], [N3, .26, 'a5', .05], [N4, .3, 'f#5', .05],
  [THEM_END + .02, .14, 'f#4', .065], [THEM_END + .16, .14, 'd4', .06], [THEM_END + .30, .14, 'a4', .065], [THEM_END + .44, .14, 'f#4', .06],
], { release: .3 }).s('gm_celesta').room(.15).rsize(1.5).orbit(8)

// ═══ VIBRAPHONE (export hangs at E6 and above: keep it at or below C6) / MUSIC BOX / HARP ═══════════════
$: line(uv([
  X([HALVED_END + .28, 1.2, 'a5', .11]),
  ...[1].flatMap((k) => run(EIGHT + k * .45, GLOW + 3.8, B, ['a5'], (i, t) => (t > HD + 127.5 ? .065 : t < GLOW - .05 ? .075 : .13), 1, { pan: +(.12 + k * .108).toFixed(3) })),
  ...[1].flatMap((k) => run(MAT + 148.60 + k * .27, UNISON - .19, B, ['a5'], .05, 1, { pan: +(.12 + k * .108).toFixed(3) })),
  [UNISON, 1.6, '[a4,a5]', .045],
], .5), { release: 2 }).s('gm_vibraphone').room(.6).rsize(4).orbit(3)

$: line(uv([
  [Q, 2.0, 'e6', .07], [K, 2.0, 'c#6', .07], [V, 2.0, 'a5', .07],                 // the cards' bells, doubled pp
  ...run(SLAM, SLAM + .6, S16, ['e6'], .025, 1),                                   // the jam, cold (a burst)
  ...[3, 5, 7].flatMap((k) => run(EIGHT + k * .45, GLOW + 3.8, B, [{ 3: 'e6', 5: 'g#6', 7: 'a6' }[k]], (i, t) => (t > HD + 127.5 ? .06 : t < GLOW - .05 ? .07 : .12), 1, { pan: +(.12 + k * .108).toFixed(3) })),
  ...[3, 5, 7].flatMap((k) => run(MAT + 148.60 + k * .27, UNISON - .19, B, [{ 3: 'e6', 5: 'g#6', 7: 'a6' }[k]], .045, 1, { pan: +(.12 + k * .108).toFixed(3) })),
  [UNISON, 1.2, 'a6', .045],
  X([NEXT_END, 2.5, 'd6', .1, { release: 2.5 }]),                                      // the D, doubled pp
], .4), { release: 1.5 }).s('gm_music_box').room(.6).rsize(4).orbit(3)

$: line(uv([
  X([MULT_END + .02, .3, 'e5', .10, { release: .5 }]), [ADD_END + .05, .25, 'a5', .09, { release: .3 }],              // "multiply, and add": in the gaps, high
  [RIVER, 1.0, '[a4,c#5,e5]', .05, { release: .8 }],                          // the cup, light
  [EDGE, .5, '[d4,f#4,a4]', .09], [EDGE_END, 1.8, '[a3,e4,a4,c#5,e5]', .15],      // IV → I, blooming in the gap
  ...run(SOFT, HALVED - .2, E, ['a5', 'c#6', 'e6'], (i) => (i % 3 === 0 ? .07 : .045), 1),   // it pours softly (three notes)
  ...run(CLOCK, 150.2 + SH, 4 * B, ['a2'], .10, 1, { pan: .5 }),                                 // the hour hand
  [UNISON, 1.6, '[a2,a3]', .06],
], .5), { release: 1.6 }).s('gm_orchestral_harp').room(.5).rsize(3).orbit(4)

// ═══ GLASS (gm_pad_bowed): the freeze ════════════════════════════════════════════════════════════════════
$: line([
  [FREEZE_END, .9, 'e6', .09, { attack: .05, release: .5 }],                     // frozen: on the line's end, in the clear
]).s('gm_pad_bowed').lpf(5000).room(.6).orbit(3)

// ═══ WOOD: cutlery at lunch, the second hand ═════════════════════════════════════════════════════════════
$: line(uv([
  ...[.92, 1.65, 2.52, 2.88, 3.90, 4.77, 5.13, 6.04].map((t, i) => [LUNCH + t, .1, i % 2 ? 'e6' : 'a6', .07]),
  ...run(CLOCK, 150.2 + SH, E, ['a6', 'e6'], (i) => (i % 2 ? .05 : .07), 1, { pan: .3 }),
], .5)).s('gm_woodblock').room(.2).orbit(6)

// ═══ THE MACHINE PULSE (oscillator, M5 in A): at once, eight heads, six blocks, the matrix, the crowd ═══
$: line([
  ...run(ONCE, A1 + 54.30, E, ['a1', 'a2', 'e2', 'a2'], (i, t) => (t < 50.9 ? .07 : t < 51.5 ? .13 : .11) + (i % 4 === 0 ? .02 : 0), .6),
  ...run(A1 + 54.38, Q - .2, 2 * B, ['a1'], .11, .5),                            // thinned, then gone under the cards
  ...run(HD + 119.38, HD + 129.5, E, ['a1', 'a2', 'e2', 'a2'], (i, t) => (t < 127.7 + SH ? .17 + Math.min(.05, (t - HD - 119.38) * .02) : t < 132.8 + SH ? .12 : .2), .6),
  ...run(CLOCK, 150.2 + SH, B, ['a1'], .10, .5),
  ...run(BLK + 137.38, BLK + 146.5, E, ['a1', 'a2', 'e2', 'a2'], (i, t) => (t < 155.3 + SH ? .11 : .15 + (t - 155.3 - SH) * .025), .6),
  ...run(MAT + 146.5, UNISON - .09, E, ['a1', 'a2', 'e2', 'a2'], (i, t) => (t < 160.1 + SH ? .2 : .12), .6),
  ...run(UNISON, MAT + 155.7, E, ['a1', 'a2'], (i, t) => (t < 168.85 + SH ? .09 : .16), .6),                         // UNISON
  ...run(CATCH - .07, FOUR_T - .03, E, ['[a1,bb1]', '[a1,bb1]', '[a1,bb1,c2]', '[a1,bb1,c2]', '[a1,bb1,c2]'], .11, .6),   // twice the words
  ...run(FOUR_T, LOOKING_END + .2, S16, ['[a1,bb1,c2]'], .12, .7),               // four times the looking
]).s('sawtooth').lpf(520).hpf(40).decay(.18).sustain(0).gain(.32).room(.2).orbit(5)

// loudness trim (render 1 measured -23.6 LUFS integrated; speech -24.9 / gaps -21.8 momentary)
all((x) => x.postgain(1.32))
