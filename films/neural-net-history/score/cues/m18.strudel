// m18 — TWO SHORES (ch14 s01-s07). dawnGold → winterBlue.
// ROUND-4 RE-FIT (2026-10-13, clock 2164.00 s): window 1767.4417–1917.935 s (150.493 s). Every absolute time in the
//    code was re-mapped piecewise and checked against its word: s01–s04b up to the end of L1410 +1.7917 s; L1410b was
//    re-narrated ('China a year or two behind? That belief burned about two years.') 0.34 s longer, so s05–s07 are
//    +2.125 s. Re-composed inside ch14-s04b to the picture's beats: the year-or-two-behind candle's G → F# now falls on
//    'behind' (beat 'out'); the three dissent tags pluck on tag1 and tag2 (the pause after L1410) and, for Beijing's
//    tag that swings in on 'two', in the breath after 'years'; the chokepoint's suspension is re-bowed after 'years'
//    and held into the cut. fx-stamp-fence ('stands' 1906.872): no struck onset within 1.1 s of it (nearest: the
//    shores' sign-off E at 1905.774, the night chord's re-voicing at 1908.684).
//    History (rounds 1-3, the 2139.54 / 2153.54 / 2159.96 s clocks) is in score/notes-history.json; the times quoted
//    in the comments below are on the current clock unless marked.
// Key: E aeolian, neither shore owns it. The melody is M4 (the rim's walk) on harp, B4 E5 – F#5 | G5 – A5 G5 |
// F#5 D5 | E5, harmonised two ways AT ONCE: left (pan .2) E minor  Em – C – D – Em (harp), right (pan .8)
// G – C – D – Em (pizzicato). Equal level, equal register, never hard-panned; no stingers, no threat, no
// national colours, no pentatonic figures. 66 BPM (beat .909 s, bar 3.636 s). Every event is in ABSOLUTE film
// seconds (line() subtracts T0).
//
// 1767.44–1781.29 strings and bass alone in the gap after L1316; the first statement, centred and soft under
//                 L1401/L1402, its last E blooming after 'rival'
// 1781.29–1805.21 phrase on the left on 'fence' (1786.80), the same phrase on the right on 'reply' (1790.56); M1's
//                 rising fourth plucked twice, a third apart: B → E in the micro-gap after 'candles' (1795.90), D → G
//                 in the breath after 'behind' (1800.43), over B-F# (the suspension), which hangs on, pp, under the
//                 new question and clears before 'tag'
// 1805.21–1824.54 THE RECEIPT: a few plucked notes, spaced as if counting from 'tag' (1805.41); one note only on
//                 'research' (1817.94)
// 1824.54–1846.25 a ticking celesta on the LEFT from 'shutter'; a quick rising run that never resolves on 'hid'
//                 (1832.75); on 'Then' (1834.81) the ticking moves to the RIGHT and stops before 'open to all'; the
//                 short low swell starts just before 'fell' (1841.46) and peaks after it, CUT; the hold to the match is
//                 a near-silent floor (pink room tone and a ppp glass E), never digital zero
// 1846.25–1861.88 THE STRUCK MATCH: M1 whole and fast on 'struck' / 'match' (1850.45): harp B on 'struck', the E and
//                 the B-F# suspension soft under 'match', the fall E → D# (B major) in the breath after it; silence to
//                 'steady' (1851.74), where the chokepoint's suspension returns pp; tags on tag1 (1851.84) and tag2
//                 (1852.44); G → F# on 'behind' (1854.07); the third tag after 'years' (1857.45), the suspension
//                 re-bowed there and held into the cut
// 1861.88–1872.50 TALENT: the left opens on the plate (1862.18), the right answers after 'China'; the full answer in
//                 the hold after 'them' (1868.95); 'America's lift in the breath after the line (1868.91)
// 1872.50–1892.54 THE NIGHT: both shores meet in ONE centred chord, cooler: Esus4(add9) E2 B2 E3 A3 F#4, re-voiced in
//                 the breaths (V1 ↔ V2, never a third); a soft inner cello walks the Two Shores contour in long notes;
//                 a soft lift on 'reached across the water' (1883.47); level and unresolved on 'Chip rules unchanged'
// 1892.54–1917.94 THE GAP: the night chord holds; only a soft E7 on 'candle' (1893.60); the gap candle lights whole
//                 (celesta, sounding B6 → E7) in the breath after 'years' (1896.53) with the first of three tags
//                 (1896.45 / 1897.45 / 1898.45); Liang over the chord alone; both shores sign off in the breath before
//                 L1418 (M4's B → E, harp left + pizz right, 1905.53); the chord floats E – D – F# (inner cello, the
//                 last onset on 'rise' 1911.40) and decays into 'close' (1914.72). m19 enters at 1916.43 in D.
// VOICE RULES carried from rounds 1-3: lift() raises onsets in the music-only GAPS about +3 dB only if the note
// (hold + release) clears the next line, shortening plucks that would ring into it; under() puts the harp melody
// and its broken chords ~5 dB down under L1401-L1403 and L1416.
const T0 = 1767.4417, DUR = 150.4933, BPM = 66
const VEL = 4.35         // global velocity scale (critic r1: about -23.9 LUFS integrated; the under-voice layers thinned instead)
// ---- seconds-based event compiler (shared by m13-m18; here events are absolute film seconds) ---
// Events are [startSec, holdSec, notes, velocity, {per-event params}]. Each lane is compiled to one
// mini-notation sequence that spans SPAN seconds, then slowed to SPAN·cps cycles, so every onset lands
// exactly where the clock needs it, independent of the tempo grid.
const CPS = BPM / 240
setcps(CPS)
const SPAN = Math.ceil(DUR) + 4
const DFLT = { pan: .5, lpf: 18000, attack: .01, release: .3 }
const r4 = (x) => (Math.round(x * 10000) / 10000).toFixed(4)
function line(evs, defs) {
  defs = defs || {}
  const sorted = evs.filter(Boolean).map((e) => [e[0] - T0, ...e.slice(1)]).filter((e) => e[0] < DUR).sort((a, b) => a[0] - b[0])
  const lanes = []
  for (const e of sorted) {
    let lane = lanes.find((l) => l.end <= e[0] + 1e-6)
    if (!lane) { lane = { end: 0, evs: [] }; lanes.push(lane) }
    lane.evs.push(e)
    lane.end = e[0] + e[1]
  }
  const keys = new Set(Object.keys(defs))
  for (const e of sorted) if (e[4]) for (const k of Object.keys(e[4])) keys.add(k)
  const seq = (lane, val) => {
    let pos = 0
    const out = []
    for (const e of lane.evs) {
      if (e[0] - pos > 1e-6) out.push('~@' + r4(e[0] - pos))
      out.push(val(e) + '@' + r4(e[1]))
      pos = e[0] + e[1]
    }
    if (SPAN - pos > 1e-6) out.push('~@' + r4(SPAN - pos))
    return mini('[' + out.join(' ') + ']')
  }
  return stack(...lanes.map((lane) => {
    let p = note(seq(lane, (e) => e[2])).velocity(seq(lane, (e) => r4(Math.min(1, e[3] * VEL))))
    for (const k of keys) p = p[k](seq(lane, (e) => (e[4] && e[4][k] != null ? e[4][k] : defs[k] != null ? defs[k] : DFLT[k] != null ? DFLT[k] : 0)))
    return p.slow(SPAN * CPS)
  }))
}
// a run of notes on a grid: from t0 (inclusive) to t1 (exclusive), one onset every `step` seconds,
// cycling through `notes`; vel may be a number or a function of (i, t); len = hold as a fraction of step
function run(t0, t1, step, notes, vel, len, params) {
  const out = []
  for (let i = 0, t = t0; t < t1 - 1e-6; i++, t = t0 + i * step) {
    const n = notes[i % notes.length]
    if (n === '~') continue
    const v = typeof vel === 'function' ? vel(i, t) : vel
    if (v <= 0) continue
    out.push([t, step * (len || 1), n, +v.toFixed(3), typeof params === 'function' ? params(i, t) : params])
  }
  return out
}
// ------------------------------------------------------------------------------------------------
const B = 60 / BPM, BAR = 4 * B
const L = .2, R = .8, C = .5
// the melody (M4 in E aeolian), as [beatOffset, beats, note] from a bar-1 downbeat
const THEME = [[0, 1, 'b4'], [1, 2, 'e5'], [3, 1, 'f#5'], [4, 2, 'g5'], [6, 1, 'a5'], [7, 1, 'g5'], [8, 1, 'f#5'], [9, 3, 'd5'], [12, 4, 'e5']]
const mel = (t0, v, pan, from = 0, to = 99) => THEME.filter((n, i) => i >= from && i <= to)
  .map(([b, d, n]) => [t0 + (b - THEME[from][0]) * B, d * B, n, v, { pan }])
// broken chords (three notes, an eighth apart) for the two harmonisations
const arp = (t, notes, v, pan) => notes.map((n, i) => [t + i * B / 2, 2 * B, n, v * (1 - i * .12), { pan }])
const LEFT = [['e2', 'b2', 'g3'], ['c2', 'g2', 'e3'], ['d2', 'a2', 'f#3'], ['e2', 'b2', 'g3']]   // Em – C – D – Em
const RIGHT = [['g2', 'd3', 'b3'], ['c2', 'g2', 'e3'], ['d2', 'a2', 'f#3'], ['e2', 'b2', 'g3']]  // G – C – D – Em
const s1 = 1769.842
const FENCE = 1786.802, REPLY = 1790.562, TAG = 1805.409
const MATCH = 1850.446, TALENT = 1862.174, NIGHT = 1872.774, GAP = 1893.604
const ANSWER = 1868.954                     // the breath after 'But America employed the most of them' (L1416 ends 1868.874)
const EMPLOYED = 1867.364                   // 'employed': the threads re-route, the left shore's lanterns brighten
// round 4: the three dissent tags swing in on the picture's beats tag1 / tag2 (the pause after L1410) and 'two'; the
// third pluck waits for the breath after 'years' (house rule: a strike pinned to a word moves into the nearest breath),
// so all three are equal plucks in clear air (review r2)
const TAGS3 = [1851.836, 1852.436, 1857.45]
const BEHIND = 1854.067, YEARS_END = 1857.352   // 'behind' (beat 'out': the year-or-two-behind candle blows out); L1410b ends
const V1 = '[e2,b2,e3,a3,f#4]', V2 = '[e2,b2,d3,a3,f#4]'   // the night chord and its re-voicing (the inner E sinks to D)
const DECAY = 1913.534, SIGN = 1905.534                        // round 2: the shores sign off in the breath before L1418; the chord decays into 'close'
// critic r1: the music-only gaps lifted about 2 dB (onsets inside them)
const GAPS = [[1767.442, 1770.534], [1779.494, 1781.744], [1794.344, 1794.844], [1804.711, 1805.771], [1820.661, 1825.061], [1851.70, 1852.80], [1857.394, 1862.734], [1868.904, 1873.064], [1890.274, 1893.074], [1896.474, 1899.374], [1905.534, 1906.034]]
// the narrator's lines in this window (absolute), from narration/timeline.json
const LINES = [[1747.721, 1754.931], [1756.458, 1764.306], [1770.725, 1776.994], [1777.444, 1779.464], [1781.892, 1794.315], [1794.915, 1804.691], [1805.808, 1813.993], [1814.443, 1820.608], [1825.142, 1834.314], [1834.814, 1839.551], [1840.001, 1841.836], [1846.650, 1851.236], [1852.836, 1857.352], [1862.775, 1868.870], [1873.100, 1880.252], [1880.752, 1890.238], [1893.142, 1896.451], [1899.451, 1905.511], [1906.071, 1915.336]]
const nextLine = (t) => (LINES.find(([a]) => a > t + 1e-6) || [1e9])[0]
// critic r1 (round 2): lift() looks at how long a note RINGS, not only where it starts. An event whose onset is in a
// gap is lifted only if onset + hold + release clears the next line; a plucked event that would ring into the line is
// shortened (it ends .15 s before the line, release .4) and then lifted; a sustained one is left at body level.
function lift(evs, rel, pluck) {
  return evs.map((e) => {
    if (!e || !GAPS.some(([a, b]) => e[0] >= a && e[0] < b)) return e
    const nx = nextLine(e[0]), r = e[4] && e[4].release != null ? e[4].release : rel
    if (e[0] + e[1] + r <= nx + .05) return [e[0], e[1], e[2], +(e[3] * 1.4).toFixed(4), e[4]]
    if (!pluck) return e
    const hold = Math.max(.1, Math.min(e[1], nx - .15 - e[0]))
    return [e[0], hold, e[2], +(e[3] * (nx - e[0] >= .35 ? 1.4 : 1)).toFixed(4), { ...(e[4] || {}), release: Math.min(r, .4) }]
  })
}
// critic r1 (round 2): under L1401, L1403 and L1416 the harp melody (and its broken chords) about 4 dB down; the
// full-level phrases stay in the gaps
const QUIET = [[1770.724, 1779.464], [1781.894, 1794.314], [1862.774, 1868.874]]   // round 3: L1402 too ('Its plan named no rival')
const under = (evs) => evs.map((e) => (e && QUIET.some(([a, b]) => e[0] >= a - .5 && e[0] < b) ? [e[0], e[1], e[2], +(e[3] * .57).toFixed(4), e[4]] : e))   // r3 composer: .63 -> .57

// ═══ HARP: the melody (both shores), the left harmonisation, the candles, the tags, the lanterns ═══════════
