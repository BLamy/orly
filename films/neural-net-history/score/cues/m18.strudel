  [1795.902, .16, 'b5', .062, { pan: C, release: .4 }], [1796.062, .4, 'e6', .068, { pan: C, release: .5 }],   // B → E after 'candles'
  [1800.432, .14, 'd6', .055, { pan: C, release: .35 }], [1800.572, .26, 'g6', .062, { pan: C, release: .35 }],   // D → G in the breath after 'behind' (round 3)
  // THE RECEIPT: counting
  [TAG, .6, 'b4', .13, { pan: L }], [TAG + 1.45, .6, 'e5', .13, { pan: R }], [TAG + 2.9, .6, 'f#5', .13, { pan: L }],
  [TAG + 4.35, .6, 'g5', .1, { pan: R }], [TAG + 5.11, .3, 'a5', .05, { pan: L, release: .5 }], [TAG + 5.4, .8, 'g5', .055, { pan: R }],   // round 3: the 'flip' pair halved (it fell on "model's"); round 4: a further -2.5 dB
  [1817.939, 1.5, 'e4', .14, { pan: C }],                                     // one note only: 'the research'
  [1819.499, 3.0, '[e3,b3]', .1, { pan: L }], [1819.499, 3.0, '[g3,d4]', .1, { pan: R }],
  // the spooling run on 'hid': rising, never resolving (stops on D)
  ...['b3', 'd4', 'e4', 'f#4', 'g4', 'a4', 'b4', 'd5'].map((n, i) => [1832.749 + i * .075, .15, n, .038 + i * .003, { pan: L, release: .35 }]),   // round 3: halved, quicker, short ring (on 'hid', clear of 'notes')
  // the falling figure on 'fall', cut at 1841.35
  ...['b4', 'a4', 'g4', 'f#4', 'e4', 'd4'].map((n, i) => [1841.469 + i * .17, .17, n, .1 - i * .008, { pan: C, release: .15 }]),
  // THE MATCH: M1 whole, fast, under 'struck match' (B → E, held, E → D#)
  [MATCH - .02, .2, 'b3', .075, { pan: C }], [MATCH + .18, .3, 'e4', .05, { pan: C, release: .2 }],  // round 3: soft under 'struck match' ...
  [MATCH + .82, .35, 'd#4', .115, { pan: C, release: .5 }],                                              // ... and the fall in the breath after 'match': the shake-out
  // 'behind' (round 4: the blow-out moved from the line's head to 'behind'): the second candle's G falls to F#, softly,
  // the F# in the micro-breath after the word
  [BEHIND, .5, 'g5', .065, { pan: C, release: .4 }], [BEHIND + .62, 1.0, 'f#5', .058, { pan: C, release: 1.0 }],
  // the three tags: one pluck each, equal (tag1, tag2, and the breath after 'years')
  ...TAGS3.map((t) => [t, .8, 'b4', .1, { pan: C }]),
  // TALENT: the melody passed back and forth, phrase by phrase
  // round 2 (L1416 is now two sentences, 1861.565-1867.665): the left opens on the plate (B, in the clear; E soft under
  // 'Nearly'), the right answers with one F# in the breath after 'China'; the full answer (G A G | F# D, right then left)
  // fills the hold after 'them', its last D clearing 'Rivals'
  ...mel(TALENT, .17, L, 0, 1), [1866.194, .3, 'f#5', .1, { pan: R, release: .4 }],
  [ANSWER, B, 'g5', .14, { pan: R }], [ANSWER + B, B / 2, 'a5', .13, { pan: R }], [ANSWER + 1.5 * B, B, 'g5', .13, { pan: R }],
  [ANSWER + 2.5 * B, B / 2, 'f#5', .13, { pan: L }], [ANSWER + 3 * B, 1.0, 'd5', .12, { pan: L }],
  // THE NIGHT: both shores meet, centred
  [NIGHT, 3.0, '[e2,b2,e3,a3,f#4]', .07, { pan: C }],
  // THE GAP: three tags, in the gap after L1417
  [1896.454, .8, 'b4', .1, { pan: C }], [1897.454, .8, 'b4', .1, { pan: C }], [1898.454, .8, 'b4', .1, { pan: C }],
  // both shores sign off: M4's opening fourth, harp on the left (pizz doubles it on the right)
  [SIGN, .24, 'b4', .1, { pan: .35, release: 1.4 }], [SIGN + .24, 1.4, 'e5', .11, { pan: .35, release: 2.2 }],
]), 2, true), { release: 2 }).s('gm_orchestral_harp').postgain(.8).room(.5).rsize(3).orbit(4)

// ═══ PIZZ: the right harmonisation (G – C – D – Em), and its answer under Beijing's phrase ══════════════
$: line(lift(under([
  ...RIGHT.flatMap((ch, i) => arp(s1 + i * BAR, ch, i === 3 ? .1 : .06, R)),
  ...arp(REPLY, RIGHT[0], .095, R),
  ...arp(ANSWER, RIGHT[1], .085, R), ...arp(TALENT, LEFT[0], .09, L),
  ...arp(EMPLOYED, LEFT[0], .05, L),                                         // 'employed': the left shore's lanterns brighten (soft, low)
  [SIGN, .24, 'b4', .12, { pan: .65 }], [SIGN + .24, .6, 'e5', .13, { pan: .65 }],   // the right shore signs off with the left
]), .6, true), { release: .6 }).s('gm_pizzicato_strings').postgain(.8).lpf(1800).room(.45).rsize(3).orbit(4)

