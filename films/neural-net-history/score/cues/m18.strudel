// cooler night colour: bowed glass, centred; and (review r1) the ppp glass E that keeps the hold before the match
// from falling to digital zero
$: line([
  [1811.409, 6.7, 'e5', .022, { attack: 2, release: .8 }],                      // the receipt's air: no hole under L1407
  [1842.609, 7.82, 'e5', .022, { attack: 2, release: .05 }],                    // near silence before the match
  [NIGHT, 12.0, '[e5,a5]', .016, { attack: 3, release: 2 }],
  [1884.724, 7.2, '[d5,a5]', .02, { attack: 3, release: 1.1 }],                   // the glass re-voices with the strings
  [1896.525, DECAY - 1896.525, '[e5,b5]', .019, { attack: 1.6, release: 2 }],   // round 3: after 'years', not under L1417
]).s('gm_pad_bowed').postgain(1.25).lpf(1700).room(.6).orbit(3)
// room tone under the hold (a floor, not a sound)
$: s(mini('[~@' + r4(1842.559 - T0) + ' pink@' + r4(MATCH - 1842.559) + ' ~@' + r4(SPAN - (MATCH - T0)) + ']')).slow(SPAN * CPS)
  .lpf(1200).hpf(100).gain(.004).attack(.8).release(.3).orbit(6)

// ═══ THE INNER LINE (critic r1): solo cello, C4-B4, very soft, walking the Two Shores contour in long notes that
// start in the breaths (E F# G A G F# D → E as the gap candle lights); under L1418 it floats E – D – F# and stops on
// the ninth, unresolved
$: line(lift([
  [1874.474, 4.2, 'e4', .035], [1878.624, 1.75, 'f#4', .04],                   // word pass: softer under L1414
  [1880.294, 4.5, 'g4', .042], [1884.724, 3.3, 'a4', .042],                    // (round 2: restored; a previous edit had commented them out)
  [1887.974, 2.3, 'g4', .048], [1890.274, 1.5, 'f#4', .06], [1891.794, 1.15, 'd4', .06, { release: .5 }],
  [1896.525, 2.6, 'e4', .045],                                                   // r3 composer: with the gap candle's E, after 'years'
  [1905.574, 3.1, 'e4', .045], [1908.684, 2.7, 'd4', .045], [1911.404, DECAY - 1911.404, 'f#4', .045, { release: 2.0 }],
], 1.3), { attack: .9, release: 1.3 }).s('gm_cello').lpf(1100).hpf(80).room(.55).rsize(4).orbit(1)

// ═══ CONTRABASS: the floor, the short low swell that peaks after 'fell' (cut at 1841.35) ═══════════════
$: line([
  [1767.542, 16.5, 'e2', .1, { attack: 2.5 }],
  [1841.209, 1.35, 'e2', .12, { attack: .6, release: .08 }],                  // swell: from 'fell', peaking after it, cut
  [NIGHT, 11.95, 'e2', .085, { attack: 2.5 }], [1884.724, 8.9, 'e2', .08, { attack: 2 }],   // re-bowed in the breath after 'water'
  [GAP, 6.93, 'b1', .09, { attack: 1.2 }], [1900.274, DECAY - 1900.274, 'e2', .08, { attack: 1.5, release: 2 }],
], { attack: 1, release: 1.5 }).s('gm_contrabass').lpf(380).hpf(40).room(.35).rsize(3).orbit(1)
$: line([[1841.209, 1.35, '[e2,b2]', .08, { attack: .65, release: .08 }]]).s('gm_cello').lpf(900).hpf(40).orbit(8)  // dry: cut clean

// ═══ CELESTA: the shutter's tick (left, then right), the match's spark, the gap candle (above D6) ═══════
$: line([
  ...run(1824.839, 1832.689, B / 2, ['e5', 'b4', 'd5', 'b4'], (i) => (i % 4 === 0 ? .025 : .016), .8, { pan: .15, release: .5 }),   // under L1408: soft (round 3: a further -2.5 dB)
  ...run(1834.819, 1838.392, B / 2, ['e5', 'b4', 'd5', 'b4'], (i) => (i % 4 === 0 ? .03 : .019), .8, { pan: .85, release: .45 }),   // round 3: stops before 'open to all'
  [MATCH - .02, .15, 'b4', .06, { release: .3 }], [MATCH + .18, .2, 'e5', .055, { release: .35 }], [MATCH + .82, .3, 'e5', .06, { release: .9 }],   // sounds B5 → E6: the spark, round 2 about 6 dB lighter
  // round 4: on the second 'two' the dark two-ring sleeve catches the living flame's light, its two ring lines brightening
  // .15 s apart: two ppp glints sounding E7 (above D7, so they clear the voice band), short
  [1856.505, .1, 'e6', .011, { release: .25 }], [1856.655, .1, 'e6', .009, { release: .3 }],
  [GAP, .1, 'e6', .012, { release: .2 }],                                                       // r3 composer: on 'candle' only a soft E7 (above D7)
  [1896.585, .14, 'b5', .03, { release: .3 }], [1896.725, .5, 'e6', .034, { release: 1.0 }],      // the gap candle lit whole in the breath after 'years': sounds B6 → E7      // the gap candle: sounds B6 → E7, ppp, in the micro-gap after 'candle' (round 3: halved, short)
], { release: 1.4 }).s('gm_celesta').room(.6).rsize(4).orbit(3)

// the match's flare: a tiny breath of noise (very short)
$: s(mini('[~@' + r4(MATCH - T0 - .02) + ' white@0.12 ~@' + r4(SPAN - (MATCH - T0) - .1) + ']')).slow(SPAN * CPS)
  .hpf(5000).lpf(10000).attack(.005).release(.15).gain(.012).orbit(6)   // round 2: above the consonants
