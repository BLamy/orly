// room tone under the hold (a floor, not a sound)
$: s(mini('[~@' + r4(1822.10 - T0) + ' pink@' + r4(MATCH - 1822.10) + ' ~@' + r4(SPAN - (MATCH - T0)) + ']')).slow(SPAN * CPS)
  .lpf(1200).hpf(100).gain(.004).attack(.8).release(.3).orbit(6)

// ═══ THE INNER LINE (critic r1): solo cello, C4-B4, very soft, walking the Two Shores contour in long notes that
// start in the breaths (E F# G A G F# D → E as the gap candle lights); under L1418 it floats E – D – F# and stops on
// the ninth, unresolved
$: line(lift([
  [1852.05, 4.2, 'e4', .035], [1856.20, 1.75, 'f#4', .04],                   // word pass: softer under L1414
  [1857.87, 4.5, 'g4', .042], [1862.30, 3.3, 'a4', .042],                    // (round 2: restored; a previous edit had commented them out)
  [1865.55, 2.3, 'g4', .048], [1867.85, 1.5, 'f#4', .06], [1869.37, 1.8, 'd4', .06],
  [1871.18, 2.9, 'e4', .045],                                                  // with the gap candle's E
  [1883.15, 3.75, 'e4', .045], [1886.90, 3.0, 'd4', .045], [1889.90, DECAY - 1889.90, 'f#4', .045, { release: 2.0 }],
], 1.3), { attack: .9, release: 1.3 }).s('gm_cello').lpf(1100).hpf(80).room(.55).rsize(4).orbit(1)

// ═══ CONTRABASS: the floor, the short low swell that peaks after 'fell' (cut at 1822.10) ═══════════════
$: line([
  [1750.75, 16.5, 'e2', .1, { attack: 2.5 }],
  [1820.75, 1.35, 'e2', .12, { attack: .6, release: .08 }],                  // swell: from 'fell', peaking after it, cut
  [NIGHT, 11.95, 'e2', .085, { attack: 2.5 }], [1862.30, 8.9, 'e2', .08, { attack: 2 }],   // re-bowed in the breath after 'water'
  [GAP, 6.93, 'b1', .09, { attack: 1.2 }], [1877.85, DECAY - 1877.85, 'e2', .08, { attack: 1.5, release: 2 }],
], { attack: 1, release: 1.5 }).s('gm_contrabass').lpf(380).hpf(40).room(.35).rsize(3).orbit(1)
$: line([[1820.75, 1.35, '[e2,b2]', .08, { attack: .65, release: .08 }]]).s('gm_cello').lpf(900).hpf(40).orbit(8)  // dry: cut clean

// ═══ CELESTA: the shutter's tick (left, then right), the match's spark, the gap candle (above D6) ═══════
$: line([
  ...run(1804.38, 1812.23, B / 2, ['e5', 'b4', 'd5', 'b4'], (i) => (i % 4 === 0 ? .04 : .026), .8, { pan: .15, release: .7 }),   // under L1408: soft (round 2: -3 dB)
  ...run(1814.36, 1818.70, B / 2, ['e5', 'b4', 'd5', 'b4'], (i) => (i % 4 === 0 ? .04 : .026), .8, { pan: .85, release: .7 }),
  [MATCH - .02, .2, 'b4', .07], [MATCH + .18, .6, 'e5', .075, { release: .8 }],   // sounds B5 → E6: the spark, round 2 about 6 dB lighter
  [1871.65, .14, 'b5', .035, { release: .3 }], [1871.79, .45, 'e6', .038, { release: .4 }],      // the gap candle: sounds B6 → E7, ppp, in the micro-gap after 'candle'
], { release: 1.4 }).s('gm_celesta').room(.6).rsize(4).orbit(3)

// the match's flare: a tiny breath of noise (very short)
$: s(mini('[~@' + r4(MATCH - T0 - .02) + ' white@0.12 ~@' + r4(SPAN - (MATCH - T0) - .1) + ']')).slow(SPAN * CPS)
  .hpf(5000).lpf(10000).attack(.005).release(.15).gain(.012).orbit(6)   // round 2: above the consonants
