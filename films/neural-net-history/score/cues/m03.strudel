// m03 "Clue Two: A Knob That Turns" (neural-net-history), 197.3217-324.2217 s (126.90 s). C major -> A minor.
// RE-BASED (review round 4, 2026-10-13) to the current clock (narration/timeline.json, 2164.00 s): the window moved
// bodily +3.5417 s since the last edit of this file (no line inside it changed), so every absolute time in the code was
// moved +3.5417 s and checked against its word; the sonified block was regenerated with tools/film/sonify-perceptron.mjs.
// ROUND-3 VOICE PASS (same day; wcheck 20 flags -> 0): the lab and Mark I ostinatos lose their roots (hpf 210) and
// ~1.4 dB under a line (80-250 Hz on L0302/L0307); the organ's chords that start under a line are darkened (lpf 950:
// 'all', 'said'); the pads under L0312 and the quotation (L0318) keep a low root and voice their upper tones at A3 and
// up; the candle's G -> C softer on 'second', its high string halo moved into the breath after 'think'; the held C
// thins away across 'one piece, or two' (the doubt stays in the G-D bass); the celesta grace moved into the breath
// after 'cheerfully'; THE FILE SEAL as in m01: the A in the breath before 'Put', the D just after 'file'; the gutter's
// C -> B softer on 'seven', the E minor bloom fills the 2 s breath and lets go before 'Then', and a low organ E steps
// down to the cello's D under the book's shadow (m04's D minor).
// setcps(1): one cycle = one second; events at ABSOLUTE film seconds (line() subtracts S).
// 76 BPM where the music is metric (beat .7895 s); grids are phased so the bar lines fall on the picture.
// The valve organ (gm_drawbar_organ) is the era's colour: M5a's ostinato (C3 G3 C4 G3) and M1 in C.
// No digital holes: the Love/Hope/Despair chord rings into the tick-tock, an organ pedal carries it into "letters".
//
//  197.32-210.85 IN (join gap 195.21-201.32): m02's open G resolves to C: the valve-organ ostinato's first downbeat
//               (198.22) sounds in the clear, 3 s before L0301; a soft motor pulse on the bar lines (C C Am F G),
//               phased so the tally's "fifty" ('learned' 210.85) lands on a downbeat: a lift to C with a celesta glint.
//  210.85-225.77 THE HEADLINE: organ + pizz oom-pah from the headline, jaunty but under the voice; ONE organ note
//               under 'conscious' (218.07); three even, short plucks ('navy' 221.13, 'papers' 221.94, 'own' 222.51).
//  225.77-238.92 THE SECOND CANDLE: M1 in C on organ, G -> C on 'second' / 'lit' (225.94 / 226.31), soft; the C held
//               (lit) over C major, the halo blooming after 'think' (230.85); on 'rim' (231.91) G-D under it (doubted).
//  239.72-250.70 THE MARK I: M5a, organ eighths from "Buffalo" (239.72) (C C Am F), one thin whirr on 'knobs'.
//  250.70-260.40 THE MARK I LEARNING, SONIFIED (generated block at the end): the real training record the picture
//               scrubs; the held mistake's knobs alone in the gaps after "learn" and "I love that"; then C major.
//  260.54-272.75 THE IF: clean pizz eighths for the theorem; on 'if' (264.50) one organ open fifth C-G (no third);
//               the resolving pluck (E: the third) on 'unpin' (267.72); the open fifth again under the new card.
//  272.75-293.21 THE MAN: light pizz and organ under the magazine line; celesta grace after 'cheerfully' (280.03);
//               the tender Fmaj7 under "Love. Hope. Despair.", blooming on the silent card (285.44); the tick-tock
//               (woodblock + pizz) as the chess slip is pinned ('slip' 290.19), over a C-G organ pedal.
//  293.41-307.54 THE LIMIT: A minor on 'letters' (293.41); the sly low clarinet D#3 -> E3 on 'false' (295.11); thin
//               held chords under the quotation; THE FILE SEAL (A 302.64, D 304.27); open A-E on 'board' (304.63).
//  307.54-324.22 THE GUTTER: the held C over G-D, M1's fall C -> B on 'seven' (313.18); E minor in the breath (314.08);
//               a low E, then the cello's D under 'shadow' (317.41): the last strike. Faded 321.22-324.22; m04 enters
//               322.22 in D minor on the cello's D.
setcps(1)

const S = 197.3217
const N = 128
const G = 2.5
const B = 60 / 76            // one beat at 76 BPM

function line(evs, defs) {
  defs = defs || {}
  evs = evs.map((e) => [e[0] - S, e[1], e[2], e[3], e[4]])
  const sorted = [...evs].sort((a, b) => a[0] - b[0])
  const lanes = []
  for (const e of sorted) {
    let lane = lanes.find((l) => l.end <= e[0] + 1e-6)
    if (!lane) { lane = { end: 0, evs: [] }; lanes.push(lane) }
    lane.evs.push(e)
    lane.end = e[0] + e[1]
  }
  const DEF = { attack: .01, release: .3, decay: 0, sustain: 1, lpf: 18000, pan: .5 }
  const keys = [...new Set([...Object.keys(defs), ...evs.flatMap((e) => Object.keys(e[4] || {}))])]
  const seq = (lane, val) => {
    let pos = 0
    const out = []
    for (const e of lane.evs) {
      if (e[0] - pos > 1e-6) out.push('~@' + (e[0] - pos).toFixed(4))
      out.push(val(e) + '@' + e[1].toFixed(4))
      pos = e[0] + e[1]
    }
    if (N - pos > 1e-6) out.push('~@' + (N - pos).toFixed(4))
    return mini('[' + out.join(' ') + ']')
  }
  return stack(...lanes.map((lane) => {
    let p = note(seq(lane, (e) => e[2])).velocity(seq(lane, (e) => e[3]))
    for (const k of keys) p = p[k](seq(lane, (e) => (e[4] && e[4][k] != null ? e[4][k] : defs[k] != null ? defs[k] : DEF[k])))
    return p.slow(N)
  }))
}
// the narrator's lines in this window (absolute, narration/timeline.json): under a line the ostinato's roots are
// high-passed (round 3: L0302 and L0307 measured < 6 dB voice-over-music in 80-250 Hz)
const LINES = [[201.325, 203.113], [203.663, 210.85], [211.975, 219.707], [220.157, 224.627], [225.767, 230.829],
  [231.379, 238.415], [239.517, 250.616], [251.166, 256.449], [257.049, 259.592], [260.725, 263.953], [264.503, 266.419],
  [273.35, 285.386], [295.408, 304.232], [308.142, 314.017], [316.017, 320.963]]
const inLine = (t) => LINES.some(([a, b]) => t >= a - .1 && t < b)
// round 3: the organ's chords that start under a line lose their upper drawbars (1-4 kHz: 'all', 'said')
const dark = (e) => (inLine(e[0]) && !(e[4] && e[4].lpf) ? [e[0], e[1], e[2], e[3], { ...(e[4] || {}), lpf: 950 }] : e)
const thin = (e) => (inLine(e[0]) ? [e[0], e[1], e[2], +(e[3] * .85).toFixed(4), { ...(e[4] || {}), hpf: 210 }] : e)   // and ~1.4 dB down (L0307 250-2k)
// M5a: organ eighths over a list of bars [root, fifth, octave] starting at t0; v = velocity per bar
function ost(t0, bars, v, eighths) {
  const ev = []
  bars.forEach((b, i) => {
    const pat = [b[0], b[1], b[2], b[1]]
    const n = eighths || 8
    for (let k = 0; k < n; k++) ev.push([t0 + (i * 4 + k / 2) * B, B / 2 * .9, pat[k % 4], Array.isArray(v) ? v[i] : v])
  })
  return ev
}

// ------------------------------------------------------------------ valve organ: the ostinato (M5a)
const SEAL_A = 302.64, SEAL_D = 304.27      // the breath after 'essence' (302.60); just after 'file' (ends 304.23)
const O1 = 210.852 - 16 * B               // section A grid: bar 4 downbeat = "learned" (210.852); bar 0 = 198.222
const O3 = 239.722                        // the Mark I grid: bar 0 = "Buffalo"
$: line([
  // A: the lab, bright and curious (C C Am | F G)
  ...ost(O1, [['c3', 'g3', 'c4'], ['c3', 'g3', 'c4'], ['a2', 'e3', 'a3']], [.13, .12, .13]),
  ...ost(O1 + 12 * B, [['f2', 'c3', 'f3']], .10, 4),            // round 3: lighter under 'fifty' / 'marked' (was .14 / .15)
  ...ost(O1 + 14 * B, [['g2', 'd3', 'g3']], .10, 4),
  // C: the Mark I (C C Am F | G | C -> drops out at the end of "toward the answer")
  // (stops where the sonified training takes over: presentation 2 lands at 250.702)
  ...ost(O3, [['c3', 'g3', 'c4'], ['c3', 'g3', 'c4'], ['a2', 'e3', 'a3'], ['f2', 'c3', 'f3']], [.125, .13, .14, .15])
    .filter((e) => e[0] < 250.592),
].map(thin), { release: .08, hpf: 110 })
  .s('gm_drawbar_organ').gain(G * 2.1).lpf(1250).room(.35).rsize(3).orbit(1)

// valve organ: chords, the candle, the held notes
$: line([
  [210.852, 1.1, '[c3,e3,g3,c4]', .11, { attack: .05 }],                          // the lift: fifty
  // the headline's oom-pah offbeats (C | F | G7 | C)
  ...[0, 1, 2, 3].map((k) => [O1 + 18 * B + k * 2 * B, B * .45, ['[e3,g3,c4]', '[f3,a3,c4]', '[f3,g3,b3]', '[e3,g3,c4]'][k], .06, { release: .2 }]),   // round 3: short ring ('walk')    // round-2 pass: -3 dB under L0303
  [218.072, 1.8, 'g3', .07, { attack: .15, release: .5 }],                        // ONE note: "conscious of its existence"
  [222.892, 1.4, '[f2,c3,a3]', .045, { attack: .5 }],                            // round 3: lighter under 'all fed the hype'
  [224.292, 1.6, '[g2,d3,b3]', .065, { attack: .4 }],
  // M1 in C: G -> C (lit); the flame (C5) held; C major, then G-D under it (doubted)
  // round-2 voice-band pass: the lighting is under "A second candle" (L0305), so the G -> C is struck softly and the
  // held C (the flame) sits about 5 dB lower under the two lines; it still holds, unresolved, through 'rim'
  [225.942, .37, 'g4', .07, { attack: .03 }],                                    // round 3: softer on 'second'
  [226.312, 10.9, 'c5', .035, { attack: .06, release: 1.5 }],                    // round 3: the flame lower under L0305/L0306; it thins away across 'one piece, or two' as the doubt stays in the bass
  [226.312, 5.5, '[c2,g2,e4]', .06, { attack: .6 }],                           // round 3: the third up out of his fundamental
  [231.912, 6.4, '[g1,d2,g2]', .058, { attack: 1.2, release: 1.2 }],          // round 3: -2 dB ('piece' 250-2k)
  // THE IF: one open fifth (no third), then again under the new card
  [264.502, 3.3, '[c2,g2]', .075, { attack: .15, release: .6 }],              // round 3: L0311 80-250 Hz
  [268.622, 4.4, '[c3,g3]', .1, { attack: .8, release: 1.2 }],           // in the clear (266.422-273.352): back up an octave
  // THE MAN: soft pad under the magazine line, then the single tender chord (Fmaj7) from "do?"
  // round 3 (L0312 80-250 Hz 5.1 dB): under the line the pads keep a low root and move their upper tones to A3 and up
  [273.192, 3.2, '[c2,g3,e4]', .055, { attack: 1 }],
  [276.392, 5.6, '[f2,a3,c4]', .055, { attack: .8, release: 1.2 }],            // rings into the Fmaj7: no hole under "do?"
  [281.792, 3.65, '[f2,a3,c4,e4]', .055, { attack: 1.2, release: .3 }],      // under "he said, Love. Hope. Despair." (L0312 to 285.382)
  [285.442, 4.75, '[f2,c3,e3,a3]', .105, { attack: .7, release: 2.5 }],       // the silent card: the tender chord blooms in the clear
  // the tick-tock's pedal, carried into "letters" (no hole)
  [290.192, 3.3, '[c3,g3]', .06, { attack: 1.2, release: .8 }],
  // THE LIMIT: A minor; held chords under the quotation
  [293.412, 2.0, '[a2,e3,a3,c4]', .1, { attack: .2 }],
  // round 3 (L0318 1-4k 6.4 dB, 'essence' 0.7 dB): the quotation's chords about 4 dB down, upper tones above A3
  [295.432, 3.8, '[a2,a3,c4,e4]', .045, { attack: 1 }],
  [299.232, 2.6, '[f2,a3,c4]', .042, { attack: .8 }],
  [301.832, 1.0, '[e2,g#3,b3]', .03, { attack: .6, release: .3 }],             // gone after 'essence': the seal's A in the clear
  [304.632, 2.8, '[a2,e3,a3]', .09, { attack: .4, release: 1.5 }],             // the file closes: open A-E
  // THE GUTTER: the C held over G-D; on "seven" C -> B, G turning to E minor
  // round-2 voice-band pass: L0319 (308.142-314.022) runs over the whole gutter, so the held C and the fall to B on
  // "seven" are soft; the B blooms at full level in the E minor chord once the line is done (314.522)
  // round 3 (L0319 1-4k 7.3, 'seven' 2.9; 'Then' and 'book' of L0320 1.1 dB): the held C and its fall softer still;
  // the E minor bloom fills the 2 s breath between the lines and has let go before 'Then'; a low E pad steps down
  // to the cello's D under the book's shadow (m04's D minor)
  [307.722, 5.46, 'c5', .04, { attack: 1, release: .1 }],
  [307.722, 5.46, '[g2,d3,g3]', .05, { attack: 1.2, release: .3 }],
  [313.182, .85, 'b4', .035, { attack: .05, release: .3 }],
  [313.182, .85, '[g2,d3,g3]', .05, { attack: .05, release: .4 }],
  [314.08, 1.05, '[e2,b2,g3]', .075, { attack: .35, release: .75 }],
  [314.08, 1.05, 'b4', .11, { attack: .3, release: .75 }],
  [315.3, 2.5, 'e2', .05, { attack: 1, release: 1.6 }],
].map(dark), { attack: .1, release: .8, lpf: 1450 })
  .s('gm_drawbar_organ').gain(G * 1.9).hpf(60).room(.5).rsize(4).orbit(2)

// ------------------------------------------------------------------ the motor whirr
// clear: brown noise + a low motor tone, only where the narrator is silent
const clear = [
  [O1 + .02, .3, .3],                                                   // the first downbeat, before L0301
]
// under: the same bursts under a line, high-passed above 2.5 kHz at -6 dB, no low motor tone
const under = [
  [O1 + 4 * B, .3, .3], [O1 + 8 * B, .3, .32], [O1 + 12 * B, .3, .34],    // the lab's pulse
  [245.812, .45, .7],                                                     // "knobs" (the real turns are sonified below)
]
// (noise ignores the note; line() carries the timing and the velocity)
$: line(clear.map((w) => [w[0], w[1], 'c3', w[2]]), { attack: .05, release: .12 })
  .s('brown').decay(.25).sustain(.35).release(.12).lpf(900).hpf(120).orbit(3)
$: line(clear.map((w) => [w[0], w[1], 'g1', w[2] * .55]), { attack: .05, release: .12 })
  .s('sawtooth').decay(.25).sustain(.3).lpf(380).vib(9).vibmod(.4).orbit(3)
$: line(under.map((w) => [w[0], w[1], 'c3', w[2] * .5]), { attack: .04, release: .1 })
  .s('pink').decay(.22).sustain(.3).release(.1).hpf(2500).lpf(7000).gain(.6).orbit(3)

