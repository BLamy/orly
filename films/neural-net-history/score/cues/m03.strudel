// ------------------------------------------------------------------ cello: the winter foreshadow
$: line([
  [314.12, 5.4, 'd2', .16, { attack: 2.2, release: 3 }],
])
  .s('gm_cello').gain(G).lpf(600).room(.5).rsize(4).orbit(7)

