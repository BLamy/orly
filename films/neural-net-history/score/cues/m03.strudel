  [SEAL_A, .3, 'a2', .3, { release: .12 }], [SEAL_D, 1.2, 'd2', .38],
], { release: .5, lpf: 1500 })
  .s('gm_pizzicato_strings').gain(G * .85).room(.35).rsize(3).orbit(4)

$: line(
