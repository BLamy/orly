  ...[0, 1, 2, 3].map((k) => [O1 + 17 * B + k * 2 * B, B * .9, ['c2', 'f2', 'g1', 'c2'][k], .3]),
  // three even plucks: the cap, the card, the slip
  [221.132, .3, 'c3', .25, { release: .25 }], [221.942, .3, 'e3', .25, { release: .25 }], [222.512, .3, 'g3', .25, { release: .25 }],   // round 3: shorter ('all' 1-4k)
  // the Mark I: low downbeats
  ...[0, 1, 2, 3].map((k) => [O3 + k * 4 * B, B * 1.6, ['c2', 'c2', 'a1', 'f1'][k], .19 + k * .015]),   // round 3: lighter under L0307
  // THE IF: the ostinato simplified to clean pizz eighths for the theorem
  ...['c3', 'g3', 'c4', 'g3', 'c3', 'g3', 'c4', 'g3', 'a2', 'e3'].map((n, k) => [260.542 + k * B / 2, B / 2, n, .18]),
  [267.722, 1.4, 'e3', .34],                                                     // the resolving pluck: the third
  // THE MAN: light walking quarters under the magazine line
  ...['c2', 'e2', 'g2', 'a2', 'f2', 'a2', 'c3', 'a2', 'g2'].map((n, k) => [273.392 + k * B, B * .9, n, .15, { lpf: 800 }]),   // round 3: lighter, darker
  // the tick-tock as the chess slip is pinned
