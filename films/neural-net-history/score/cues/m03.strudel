  .s('gm_cello').gain(G).lpf(600).room(.5).rsize(4).orbit(7)

// <sonify:perceptron>
// GENERATED by tools/film/sonify-perceptron.mjs from PERCEPTRON_RUN (seed 1958) and ch03-s04's step schedule on
// the current clock. Do not edit by hand: re-run the tool. Presentations 2-95 shown
// (16 mistakes heard as motor ratchets; right answers are silent).
// the eye: a relay clack per presentation (909 rimshot + a low armature thump in the clear)
$: line([[250.704,0.03,'c3',0.7],[256.58,0.03,'c3',0.5],[256.708,0.03,'d3',0.5],[256.837,0.03,'c3',0.5]], { attack: .001, release: .02 })
  .s('rim').bank('RolandTR909').gain(.36).hpf(300).room(.18).rsize(2).orbit(5)
