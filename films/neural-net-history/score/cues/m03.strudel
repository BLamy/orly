// m03 "Clue Two: A Knob That Turns" (neural-net-history), 194.03-320.93 s (126.90 s). C major -> A minor.
// Review round 1 re-fit: every hit is placed on the NEW clock (narration/timeline.json, film 2121.42 s).
// setcps(1): one cycle = one second; events at ABSOLUTE film seconds (line() subtracts S).
// 76 BPM where the music is metric (beat .7895 s); grids are phased so the bar lines fall on the picture.
// The valve organ (gm_drawbar_organ) is the era's colour: M5a's ostinato (C3 G3 C4 G3) and M1 in C.
// Masking pass (score round 2): the lab and Mark I ostinatos trimmed ~1.5 dB under L0302 / L0307, the doubted
// bass loses its D3, and the IF's open fifth drops below the voice under the line (C2-G2), back to C3-G3 in the clear.
// Review notes applied: the Mark I's whirrs under speech are high-passed (above 2.5 kHz, -6 dB, no low
// motor tone); full whirrs only sound in the clear (the gap after "answer", after "learn", after "that").
// No digital holes: the Love/Hope/Despair chord rings into the tick-tock, an organ pedal carries the
// tick-tock into "letters".
//
//  194.03-207.6 IN (join gap 191.91-198.03): m02's open G resolves to C: the valve-organ ostinato's first
//               downbeat (194.93) sounds in the clear, 3 s before L0301; a soft motor pulse on the bar lines
//               (C C Am F G), phased so the tally's "fifty" ("learned" 207.56) lands on a downbeat: a lift to
//               C with a celesta glint.
//  207.6-222.6  THE HEADLINE: organ + pizz oom-pah from the headline (208.35), jaunty but under the voice; it
//               thins to ONE organ note under "conscious of its existence" (214.78); three even plucks for the
//               cap, the card and the slip ("navy" 217.84, "papers" 218.65, "own" 219.22); F - G after.
//  222.6-235.6  THE SECOND CANDLE: M1 in C on organ, G -> C on "second" / "candle" (222.65 / 223.02); the C
//               held high (lit) over C major; on "rim" (228.62) the bass drops to G-D under it (doubted).
//  236.4-247.4  THE MARK I: M5a, organ eighths from "Buffalo" (236.43) (C C Am F), one thin whirr on "knobs".
//  247.4-257.2  THE MARK I LEARNING, SONIFIED (generated block at the end, tools/film/sonify-perceptron.mjs):
//               the real training record the picture scrubs: a celesta tick per presentation, motors that turn
//               only on mistakes (glide up/down with the weight change), an organ pad that resolves from a
//               cluster to C major as the mistake rate falls, the held mistake's knobs alone in the gaps after
//               "learn" and "I love that", then C major (it learned).
//  257.3-269.5  THE IF: clean pizzicato eighths for the theorem; on "If" (261.21) everything stops but one
//               sustained organ open fifth C-G (no third); a resolving pluck (E: the third, at last) as the
//               old card drops ("unpin" 264.43); the open fifth returns under the new card (265.33).
//  269.5-289.9  THE MAN: light, warm pizz and organ under the magazine line; a celesta grace on "cheerfully"
//               (276.19); from "do?" the organ is a single tender Fmaj7 (278.5), the only sound under "Love.
//               Hope. Despair." and the silent card that follows; it rings into the tick-tock (woodblock +
//               pizz) as the chess slip is pinned (286.89), over a soft C-G organ pedal into "letters".
//  290.1-304.3  THE LIMIT: the organ turns to A minor on "letters" (290.12); a sly two-note low clarinet
//               figure (D#3 -> E3) on the false clue (291.82); soft held chords under the quoted sentence; the
//               FILE SEAL on "file" (300.50), landing on an open A-E chord as the file closes ("board" 301.34).
//  304.3-320.9  THE GUTTER: the held C (organ) over G-D, then M1's fall C -> B exactly on "seven" (309.89), G
//               turning to E minor; a low cello D2 under the book's shadow (314.12), intensity .2. Last onset
//               314.12; faded 317.93-320.93; m04 enters at 318.93 in D minor on the cello's D.
setcps(1)

const S = 194.03
const N = 128
const G = 2.5
const B = 60 / 76            // one beat at 76 BPM

function line(evs, defs) {
  defs = defs || {}
  evs = evs.map((e) => [e[0] - S, e[1], e[2], e[3], e[4]])
  const sorted = [...evs].sort((a, b) => a[0] - b[0])
  const lanes = []
  for (const e of sorted) {
    let lane = lanes.find((l) => l.end <= e[0] + 1e-6)
    if (!lane) { lane = { end: 0, evs: [] }; lanes.push(lane) }
    lane.evs.push(e)
    lane.end = e[0] + e[1]
  }
  const DEF = { attack: .01, release: .3, decay: 0, sustain: 1, lpf: 18000, pan: .5 }
  const keys = [...new Set([...Object.keys(defs), ...evs.flatMap((e) => Object.keys(e[4] || {}))])]
  const seq = (lane, val) => {
    let pos = 0
    const out = []
    for (const e of lane.evs) {
      if (e[0] - pos > 1e-6) out.push('~@' + (e[0] - pos).toFixed(4))
      out.push(val(e) + '@' + e[1].toFixed(4))
      pos = e[0] + e[1]
    }
    if (N - pos > 1e-6) out.push('~@' + (N - pos).toFixed(4))
    return mini('[' + out.join(' ') + ']')
  }
  return stack(...lanes.map((lane) => {
    let p = note(seq(lane, (e) => e[2])).velocity(seq(lane, (e) => e[3]))
    for (const k of keys) p = p[k](seq(lane, (e) => (e[4] && e[4][k] != null ? e[4][k] : defs[k] != null ? defs[k] : DEF[k])))
    return p.slow(N)
  }))
}
// M5a: organ eighths over a list of bars [root, fifth, octave] starting at t0; v = velocity per bar
function ost(t0, bars, v, eighths) {
  const ev = []
  bars.forEach((b, i) => {
    const pat = [b[0], b[1], b[2], b[1]]
    const n = eighths || 8
    for (let k = 0; k < n; k++) ev.push([t0 + (i * 4 + k / 2) * B, B / 2 * .9, pat[k % 4], Array.isArray(v) ? v[i] : v])
  })
  return ev
}

// ------------------------------------------------------------------ valve organ: the ostinato (M5a)
const O1 = 207.56 - 16 * B               // section A grid: bar 4 downbeat = "learned" (207.56); bar 0 = 194.93
const O3 = 236.43                        // the Mark I grid: bar 0 = "Buffalo"
$: line([
  // A: the lab, bright and curious (C C Am | F G)
  ...ost(O1, [['c3', 'g3', 'c4'], ['c3', 'g3', 'c4'], ['a2', 'e3', 'a3']], [.13, .12, .13]),
  ...ost(O1 + 12 * B, [['f2', 'c3', 'f3']], .14, 4),
  ...ost(O1 + 14 * B, [['g2', 'd3', 'g3']], .15, 4),
  // C: the Mark I (C C Am F | G | C -> drops out at the end of "toward the answer")
  // (stops where the sonified training takes over: presentation 2 lands at 247.41)
  ...ost(O3, [['c3', 'g3', 'c4'], ['c3', 'g3', 'c4'], ['a2', 'e3', 'a3'], ['f2', 'c3', 'f3']], [.125, .13, .14, .15])
    .filter((e) => e[0] < 247.3),
], { release: .08 })
  .s('gm_drawbar_organ').gain(G * 2.1).hpf(110).lpf(1250).room(.35).rsize(3).orbit(1)

// valve organ: chords, the candle, the held notes
$: line([
  [207.56, 1.4, '[c3,e3,g3,c4]', .13, { attack: .05 }],                          // the lift: fifty
  // the headline's oom-pah offbeats (C | F | G7 | C)
  ...[0, 1, 2, 3].map((k) => [O1 + 18 * B + k * 2 * B, B * .45, ['[e3,g3,c4]', '[f3,a3,c4]', '[f3,g3,b3]', '[e3,g3,c4]'][k], .1]),
  [214.78, 1.8, 'g3', .09, { attack: .15, release: .5 }],                        // ONE note: "conscious of its existence"
  [219.6, 1.4, '[f2,c3,a3]', .07, { attack: .5 }],
  [221.0, 1.6, '[g2,d3,b3]', .08, { attack: .4 }],
  // M1 in C: G -> C (lit); the flame (C5) held; C major, then G-D under it (doubted)
  [222.65, .37, 'g4', .17, { attack: .03 }],
  [223.02, 11.9, 'c5', .088, { attack: .06, release: 1.5 }],
  [223.02, 5.5, '[c2,g2,e3]', .08, { attack: .6 }],
  [228.62, 6.4, '[g1,d2,g2]', .085, { attack: 1.2, release: 1.2 }],
  // THE IF: one open fifth (no third), then again under the new card
  [261.21, 3.3, '[c2,g2]', .1, { attack: .15, release: .6 }],
  [265.33, 4.4, '[c3,g3]', .1, { attack: .8, release: 1.2 }],           // in the clear (263.13-270.06): back up an octave
  // THE MAN: soft pad under the magazine line, then the single tender chord (Fmaj7) from "do?"
  [269.9, 3.2, '[c2,g2,e3]', .06, { attack: 1 }],
  [273.1, 5.6, '[f2,c3,a3]', .06, { attack: .8, release: 1.2 }],            // rings into the Fmaj7: no hole under "do?"
  [278.5, 8.4, '[f2,c3,e3,a3]', .105, { attack: 1.2, release: 2.5 }],
  // the tick-tock's pedal, carried into "letters" (no hole)
  [286.9, 3.3, '[c3,g3]', .06, { attack: 1.2, release: .8 }],
  // THE LIMIT: A minor; held chords under the quotation
  [290.12, 2.0, '[a2,e3,a3,c4]', .1, { attack: .2 }],
  [292.14, 3.8, '[a2,e3,a3,c4]', .07, { attack: 1 }],
  [295.94, 2.6, '[f2,c3,a3]', .065, { attack: .8 }],
  [298.54, 1.9, '[e2,b2,g#3]', .07, { attack: .6, release: .4 }],
  [301.34, 2.8, '[a2,e3,a3]', .09, { attack: .4, release: 1.5 }],             // the file closes: open A-E
  // THE GUTTER: the C held over G-D; on "seven" C -> B, G turning to E minor
  [304.43, 5.46, 'c5', .09, { attack: 1, release: .1 }],
  [304.43, 5.46, '[g2,d3,g3]', .07, { attack: 1.2, release: .3 }],
  [309.89, 2.6, 'b4', .12, { attack: .05, release: 1.8 }],
  [309.89, 1.4, '[g2,d3,g3]', .08, { attack: .05, release: .6 }],
  [311.23, 2.6, '[e2,b2,g3]', .07, { attack: .6, release: 1.8 }],
], { attack: .1, release: .8 })
  .s('gm_drawbar_organ').gain(G * 1.9).hpf(60).lpf(1450).room(.5).rsize(4).orbit(2)

// ------------------------------------------------------------------ the motor whirr
// clear: brown noise + a low motor tone, only where the narrator is silent
const clear = [
  [O1 + .02, .3, .3],                                                   // the first downbeat, before L0301
]
// under: the same bursts under a line, high-passed above 2.5 kHz at -6 dB, no low motor tone
const under = [
  [O1 + 4 * B, .3, .3], [O1 + 8 * B, .3, .32], [O1 + 12 * B, .3, .34],    // the lab's pulse
  [242.52, .45, .7],                                                     // "knobs" (the real turns are sonified below)
]
// (noise ignores the note; line() carries the timing and the velocity)
$: line(clear.map((w) => [w[0], w[1], 'c3', w[2]]), { attack: .05, release: .12 })
  .s('brown').decay(.25).sustain(.35).release(.12).lpf(900).hpf(120).orbit(3)
$: line(clear.map((w) => [w[0], w[1], 'g1', w[2] * .55]), { attack: .05, release: .12 })
  .s('sawtooth').decay(.25).sustain(.3).lpf(380).vib(9).vibmod(.4).orbit(3)
$: line(under.map((w) => [w[0], w[1], 'c3', w[2] * .5]), { attack: .04, release: .1 })
  .s('pink').decay(.22).sustain(.3).release(.1).hpf(2500).lpf(7000).gain(.6).orbit(3)

// room tone under the solo whirrs (253.0-257.6): a sine C at about -30 dB, so "You could hear it learn" never
// sits over digital silence (review: no holes)
$: line([
  [253.0, 4.6, 'c2', .5, { attack: .5, release: .8 }],
])
  .s('sine').gain(.03).lpf(300).orbit(3)

// ------------------------------------------------------------------ pizzicato: oom-pah, plucks, the IF, the man
$: line([
  [207.56, .5, 'c2', .32],
  // the headline: oom on 1 and 3
  ...[0, 1, 2, 3].map((k) => [O1 + 17 * B + k * 2 * B, B * .9, ['c2', 'f2', 'g1', 'c2'][k], .3]),
  // three even plucks: the cap, the card, the slip
  [217.84, .5, 'c3', .3], [218.65, .5, 'e3', .3], [219.22, .5, 'g3', .3],
  // the Mark I: low downbeats
  ...[0, 1, 2, 3].map((k) => [O3 + k * 4 * B, B * 1.6, ['c2', 'c2', 'a1', 'f1'][k], .26 + k * .02]),
  // THE IF: the ostinato simplified to clean pizz eighths for the theorem
  ...['c3', 'g3', 'c4', 'g3', 'c3', 'g3', 'c4', 'g3', 'a2', 'e3'].map((n, k) => [257.25 + k * B / 2, B / 2, n, .18]),
  [264.43, 1.4, 'e3', .34],                                                     // the resolving pluck: the third
  // THE MAN: light walking quarters under the magazine line
  ...['c2', 'e2', 'g2', 'a2', 'f2', 'a2', 'c3', 'a2', 'g2'].map((n, k) => [270.1 + k * B, B * .9, n, .2]),
  // the tick-tock as the chess slip is pinned
  ...[0, 1, 2, 3].map((k) => [286.89 + k * B, B * .5, k % 2 ? 'g2' : 'c3', .2]),
  // FILE SEAL on "file"
  [300.5, .55, 'a2', .36], [301.08, 1.6, 'd2', .38],
], { release: .5 })
  .s('gm_pizzicato_strings').gain(G * .85).lpf(1500).room(.35).rsize(3).orbit(4)

$: line(
  [0, 1, 2, 3].map((k) => [286.89 + k * B, .3, k % 2 ? 'g5' : 'c6', .12]),
).s('gm_woodblock').gain(G).lpf(3500).room(.3).orbit(4)

// ------------------------------------------------------------------ celesta grace notes (heard an octave up)
$: line([
  [207.56, 1.4, 'g5', .14], [207.73, 1.2, 'c6', .12],                          // fifty
  [276.19, .2, 'd5', .14], [276.32, 1.6, 'e5', .17],                           // "cheerfully"
