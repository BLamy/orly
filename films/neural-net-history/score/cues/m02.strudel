// m02 "Clue One: A Switch That Fires" (neural-net-history), 74.2667-199.3217 s (125.055 s). G major, celesta.
// WORD PASS (critic r1 per-word floor, 2026-10-13, not re-composed; wcheck 0 flags): the wick tick on 'All' (91.17)
// halved and shortened; the lantern bed [g2,d3] (86.42) behind lpf 750 (its bow noise was the 1-4k floor under 'All');
// the flame's G5 (113.87) and the doubted D-A (122.90) behind lpf 1000 ('more' 126.19); the suspension's G5 (175.82)
// .068 -> .04 behind lpf 900 and its D-A behind lpf 1000 ('before' 183.41). Strings lpf is now per event (defs lpf 1200).
// Words: All 1.7 -> 7.4, before 0.3 -> 4.4, more 4.3 dB (1-4k); every line 9.4-22 dB. Render -24.0 LUFS I, TP -7.0.
// REVIEW ROUND 5 (2026-10-13, clock unchanged: L0220 ends 195.212 on 'it'): the X-ray no longer crowds the silence
// after 'name on it'. Nothing but the room tone for 1.0 s after 'it'; the celesta D enters at 196.22 and the G at
// 196.70 (the open G under it, struck with the G), the whole block about 8 dB softer (render peak about -25 M
// (renders vary +-1 dB), master about -25.5 M before m03's fade-in), and the low G already decaying before the fade (198.322-199.322, fadeOut
// 1.0 s, 1.62 s after the last strike 196.70; it overlaps m03's 2-s fade-in, all inside the gap to L0301 201.32).
// RE-FIT (round 4, 2026-10-13) to the current clock (narration/timeline.json, 2164 s): ch02-s01..s07 and ch02-s08 up to
// L0220 moved bodily (+2.1667 s against this file's previous fit), L0220 was re-narrated 1.375 s longer
// (188.919-195.212, 'paper' 189.14), so the X-ray hits and the fade move +3.5417. Every absolute time in this file,
// code and comments, was moved with its word or beat and checked; S = the current window start. No hit names a word
// of L0220: the near silence under it is just the room tone, now held across the longer line. Older notes are history.
// CRITIC R1 / ROUND 3 (2026-10-13), measured per line in 250-2k / 1-4k (gain -4 dB, no duck), every line now
// >= 9.4 dB in both (L0216 was 6.9 hi, L0204/L0212 7.3, L0219 7.0 hi on a re-render; renders vary +-0.8 dB):
// Widrow's celesta is ONE short soft pair (D on "Bernard", G on "Widrow"); the downhill slide B-A-G-F# moved to
// the cello below D3, landing on E with the celesta's lone E after "wrong"; the 'All' chime is a damped tick and
// the firing dyad D-G (heard D5-G5, under 1 kHz) blooms in the breath after "All" and again after "fired" (the
// high G-D chime there had dominated L0204's 1-4k band); L0204's plucks -1 dB; Turing's music-box rise -1 dB and
// its top D moved off "machine" into the clear (145.00); the suspension's G5 -2 dB.
// VOICE-BAND PASS (critic r1, 2026-10-12): every line measured in the 250-2k and 1-4k bands (whole line, no duck)
// and now >= 8.2 dB clear in both (was -2.0): under a line the celesta/music box sit 6 dB lower or move into the
// breaths ('fired' chime -> 95.62, 'logic' -> 101.52, the network notes into its two breaths, Hebb's thickening into
// the hold after "grows", Turing's top D after "machine", Widrow's E struck and let go before "Remember him");
// the candle's D -> G -4.5 dB, struck and let go, its string G5 hold -4 dB; the file seal, the slip chord and the
// celesta question end before the next line; the chorale under L0215 softer and darker (lpf 1050).
// Masking pass (score round 2): the lit candle (L0209) and the fall on "sixteen" (L0219) trimmed; the fall's
// D major is now D-A below with the F# on top (the flame's own note), nothing in the voice's band.
// Review round 1 re-fit: every hit is placed on the NEW clock (narration/timeline.json, film 2121.42 s).
// setcps(1): one cycle = one second. Events are written at ABSOLUTE film seconds; line() subtracts the
// cue start S. Events: [filmSec, lenSec, notes, velocity, {per-event params}]. Body = 125.055 cycles.
// gm_celesta sounds an octave above the written note (written d4 = heard D5), so celesta under speech is
// written d4 and up (heard D5+). Mid-range strings under a line stay at velocity <= .14 behind lpf 1200.
//
//  74.27-77.42  IN under m01's fade (join gap 68.00-78.02): strings take over m01's held D4 (the D becomes the
//              fifth of G); the low G enters at 76.22 as m01's A-E is gone; the wick glint on "wickCatch"
//              (76.90) is the first celesta note (heard D6), alone before L0201 (78.02).
//  77.42-86.42   a curious celesta figure in the gaps around "Chicago, around 1941" and the Pitts/McCulloch
//              line (80.28, 85.52); low G strings, cello, far-off train rumble.
//  86.42-104.52  THE LOGIC LANTERNS: the celesta is the machine. A soft pluck when an input lights ("oneIn"
//              90.21), a damped tick when the wick catches ("fire" 91.17) blooming into the D-G firing dyad in the breath (91.57), a rest when it snaps dark ("dark"
//              92.16); three input plucks under "Enough signals at once" summed into one chime on "fired"
//              (95.12); a little chime chain along "network"; AND (102.07: pluck, pluck, chime only on both)
//              and OR (103.31: one pluck, chime at once).
//  104.52-112.42 M2's walk for the pinning (104.88), stopping dead; a held cello D2 under "The nets could not
//              learn" (108.58); the FILE SEAL on "file" (110.97): A -> D. The D is the dominant: the candle can
//              now be lit in G.
//  112.42-128.32 M1 IN G, lit: celesta D -> G exactly on "light" (113.21) / "intoFlame" (113.87), the flame
//              held high by strings (G5) over G major; on "Gerard" (122.90) the bass moves to D-A under the
//              held G (doubted). No resolution.
//  128.32-136.62 HEBB: a ghost touch (B, celesta) on each pass (130.93, 131.65, 133.16: the words "cell", "fire",
//              "grows"), then in the reading hold the two-note figure B -> D three times, each fuller (celesta,
//              + music box, + harp: 133.78, 134.84, 135.90), decayed before "Alan" (137.23).
//  136.62-149.42 TURING: a hopeful IV-V-I turn under "educate a child machine" (143.39-143.97) with a music-box
//              rise (high, ghosted; its top D after "machine", 145.00); the walk, quietly, for the slip pin (145.07); a soft held G chord while the slip
//              is read (speech-free 144.97-150.06).
//  149.42-176.02 DARTMOUTH: a soft valve-organ chorale G - G/B - C on "name" (152.38) - D in the gap after
//              "intelligence" (154.83) - G/D - Em - C, thinning to ONE organ note on "symbols" (159.52).
//              Widrow (163.14-172.30): solo celesta, M1's rising fourth D -> G on "Bernard Widrow" (164.09/164.51),
//              one short soft pair; the cello slides downhill below D3 ("sliding" 170.09 ... "less" 171.68) and
//              lands on E with the celesta after "wrong" (172.30/172.34), unresolved. "Remember him" (172.90) in near silence.
//  176.02-199.32 THE CANDLE OUT: the held G over D-A (the suspension) under the frog's-eye line (176.60-184.90);
//              the FALL G -> F# with a D major chord exactly on "sixteen" (187.26); near silence for "The
//              paper that put it out..." (188.92-195.21); then 1.0 s of room tone only (the silence does the
//              work); under the X-ray image a faint high shimmer and the rising fourth once more, softly, late,
//              as if kept (D 196.22, ~1.0 s after "it"; G 196.70 with a soft open G below). Last onset 196.70;
//              the open G (V of C) is already decaying when the fade runs (198.32-199.32); m03's C-major organ
//              enters at 197.32 (its 2-s fade-in).
setcps(1)

const S = 74.2667     // cue start (film seconds)
const N = 126         // cycles covered by each compiled lane (body 125.055)
const G = 2.7         // level trim (target about -21 LUFS integrated)

function line(evs, defs) {
  defs = defs || {}
  evs = evs.map((e) => [e[0] - S, e[1], e[2], e[3], e[4]])
  const sorted = [...evs].sort((a, b) => a[0] - b[0])
  const lanes = []
  for (const e of sorted) {
    let lane = lanes.find((l) => l.end <= e[0] + 1e-6)
    if (!lane) { lane = { end: 0, evs: [] }; lanes.push(lane) }
    lane.evs.push(e)
    lane.end = e[0] + e[1]
  }
  const DEF = { attack: .01, release: .3, decay: 0, sustain: 1, lpf: 18000, pan: .5 }
  const keys = [...new Set([...Object.keys(defs), ...evs.flatMap((e) => Object.keys(e[4] || {}))])]
  const seq = (lane, val) => {
    let pos = 0
    const out = []
    for (const e of lane.evs) {
      if (e[0] - pos > 1e-6) out.push('~@' + (e[0] - pos).toFixed(4))
      out.push(val(e) + '@' + e[1].toFixed(4))
      pos = e[0] + e[1]
    }
    if (N - pos > 1e-6) out.push('~@' + (N - pos).toFixed(4))
    return mini('[' + out.join(' ') + ']')
  }
  return stack(...lanes.map((lane) => {
    let p = note(seq(lane, (e) => e[2])).velocity(seq(lane, (e) => e[3]))
    for (const k of keys) p = p[k](seq(lane, (e) => (e[4] && e[4][k] != null ? e[4][k] : defs[k] != null ? defs[k] : DEF[k])))
    return p.slow(N)
  }))
}

// ------------------------------------------------------------------ celesta: the lead (heard an octave up)
$: line([
