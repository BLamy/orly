// m02 "Clue One: A Switch That Fires" (neural-net-history), 72.35-196.03 s (123.68 s). G major, celesta.
// VOICE-BAND PASS (critic r1, 2026-10-12): every line measured in the 250-2k and 1-4k bands (whole line, no duck)
// and now >= 8.2 dB clear in both (was -2.0): under a line the celesta/music box sit 6 dB lower or move into the
// breaths ('fired' chime -> 93.70, 'logic' -> 99.60, the network notes into its two breaths, Hebb's thickening into
// the hold after "grows", Turing's top D after "machine", Widrow's E struck and let go before "Remember him");
// the candle's D -> G -4.5 dB, struck and let go, its string G5 hold -4 dB; the file seal, the slip chord and the
// celesta question end before the next line; the chorale under L0215 softer and darker (lpf 1050).
// Masking pass (score round 2): the lit candle (L0209) and the fall on "sixteen" (L0219) trimmed; the fall's
// D major is now D-A below with the F# on top (the flame's own note), nothing in the voice's band.
// Review round 1 re-fit: every hit is placed on the NEW clock (narration/timeline.json, film 2121.42 s).
// setcps(1): one cycle = one second. Events are written at ABSOLUTE film seconds; line() subtracts the
// cue start S. Events: [filmSec, lenSec, notes, velocity, {per-event params}]. Body = 123.68 cycles.
// gm_celesta sounds an octave above the written note (written d4 = heard D5), so celesta under speech is
// written d4 and up (heard D5+). Mid-range strings under a line stay at velocity <= .14 behind lpf 1200.
//
//  72.35-75.5  IN under m01's fade (join gap 66.06-76.10): strings take over m01's held D4 (the D becomes the
//              fifth of G); the low G enters at 74.3 as m01's A-E is gone; the wick glint on "wickCatch"
//              (74.98) is the first celesta note (heard D6), alone before L0201 (76.10).
//  75.5-84.5   a curious celesta figure in the gaps around "Chicago, around 1941" and the Pitts/McCulloch
//              line (78.36, 83.6); low G strings, cello, far-off train rumble.
//  84.5-102.6  THE LOGIC LANTERNS: the celesta is the machine. A soft pluck when an input lights ("oneIn"
//              88.29), a bright chime when the wick catches ("fire" 89.25), a rest when it snaps dark ("dark"
//              90.24); three input plucks under "Enough signals at once" summed into one chime on "fired"
//              (93.20); a little chime chain along "network"; AND (100.15: pluck, pluck, chime only on both)
//              and OR (101.39: one pluck, chime at once).
//  102.6-110.5 M2's walk for the pinning (102.96), stopping dead; a held cello D2 under "The nets could not
//              learn" (106.66); the FILE SEAL on "file" (109.05): A -> D. The D is the dominant: the candle can
//              now be lit in G.
//  110.5-126.4 M1 IN G, lit: celesta D -> G exactly on "light" (111.29) / "intoFlame" (111.95), the flame
//              held high by strings (G5) over G major; on "Gerard" (120.98) the bass moves to D-A under the
//              held G (doubted). No resolution.
//  126.4-134.7 HEBB: a ghost touch (B, celesta) on each pass (129.01, 129.73, 131.24: the words "cell", "fire",
//              "grows"), then in the reading hold the two-note figure B -> D three times, each fuller (celesta,
//              + music box, + harp: 131.86, 132.92, 133.98), decayed before "Alan" (135.31).
//  134.7-147.5 TURING: a hopeful IV-V-I turn under "educate a child machine" (141.47-142.05) with a music-box
//              rise (high); the walk, quietly, for the slip pin (143.15); a soft held G chord while the slip
//              is read (speech-free 143.05-148.14).
//  147.5-174.1 DARTMOUTH: a soft valve-organ chorale G - G/B - C on "name" (150.46) - D in the gap after
//              "intelligence" (152.91) - G/D - Em - C, thinning to ONE organ note on "symbols" (157.60).
//              Widrow (161.22-170.38): solo celesta, M1's rising fourth D -> G on "Widrow" (162.59), tender,
//              then a line that slides downhill ("sliding" 168.17 ... "wrong" 170.05), all at <= .14 under the
//              line, and stops on E after "wrong" (170.42), unresolved. "Remember him" (170.98) in near silence.
//  174.1-196.0 THE CANDLE OUT: the held G over D-A (the suspension) under the frog's-eye line (174.68-182.98);
//              the FALL G -> F# with a D major chord exactly on "sixteen" (185.34); near silence for "The
//              paper that put it out..." (187.00-191.91); under the X-ray a faint high shimmer and the rising
//              fourth once more, softly (D on "xray" 192.21 -> G on "xrayBand1" 192.71). Last onset 192.71;
//              ends on an open G (V of C) ringing through the fade (194.43-196.03); m03's C-major organ
//              enters at 194.03.
setcps(1)

const S = 72.35       // cue start (film seconds)
const N = 125         // cycles covered by each compiled lane (body 123.68)
const G = 2.7         // level trim (target about -21 LUFS integrated)

function line(evs, defs) {
  defs = defs || {}
  evs = evs.map((e) => [e[0] - S, e[1], e[2], e[3], e[4]])
  const sorted = [...evs].sort((a, b) => a[0] - b[0])
  const lanes = []
  for (const e of sorted) {
    let lane = lanes.find((l) => l.end <= e[0] + 1e-6)
    if (!lane) { lane = { end: 0, evs: [] }; lanes.push(lane) }
    lane.evs.push(e)
    lane.end = e[0] + e[1]
  }
  const DEF = { attack: .01, release: .3, decay: 0, sustain: 1, lpf: 18000, pan: .5 }
  const keys = [...new Set([...Object.keys(defs), ...evs.flatMap((e) => Object.keys(e[4] || {}))])]
  const seq = (lane, val) => {
    let pos = 0
    const out = []
    for (const e of lane.evs) {
      if (e[0] - pos > 1e-6) out.push('~@' + (e[0] - pos).toFixed(4))
      out.push(val(e) + '@' + e[1].toFixed(4))
      pos = e[0] + e[1]
    }
    if (N - pos > 1e-6) out.push('~@' + (N - pos).toFixed(4))
    return mini('[' + out.join(' ') + ']')
  }
  return stack(...lanes.map((lane) => {
    let p = note(seq(lane, (e) => e[2])).velocity(seq(lane, (e) => e[3]))
    for (const k of keys) p = p[k](seq(lane, (e) => (e[4] && e[4][k] != null ? e[4][k] : defs[k] != null ? defs[k] : DEF[k])))
    return p.slow(N)
  }))
}

// ------------------------------------------------------------------ celesta: the lead (heard an octave up)
$: line([
  // the wick catches: the first note, alone
  [74.98, .6, 'd5', .2, { release: .4 }],
  // the 1940s, curious: in the gaps
  [78.36, .25, 'd5', .2], [78.6, .5, 'c5', .18],                                           // after "Chicago, around 1941"
  [83.6, .3, 'b4', .22], [83.85, .3, 'a4', .2], [84.1, .3, 'g4', .2], [84.4, .5, 'a4', .2, { release: .35 }], // a question, gone before "In" (85.14)
  // the logic lanterns: pluck (input) / chime (fire). Voice-band pass (critic r1): under L0203/L0204 the plucks are
  // ghosts (~-6 dB) and the bright chimes sit in the breaths ('fired' -> 93.70, 'logic' -> 99.60); the one chime
  // the picture pins to a word ('fire' 89.25 = "All") is a single soft G, short, so "or nothing" is clear.
  [88.29, .3, 'e4', .08],                                                                   // input lights ("oneIn")
  [89.25, .35, 'g4', .1, { release: .3 }],                                                   // the wick catches ("fire")
  // "dark" 90.24: rest
  [91.62, .2, 'e4', .07], [92.02, .2, 'e4', .075], [92.42, .2, 'e4', .08],                // enough signals at once...
  [93.7, .35, '[g4,d5]', .15, { release: .3 }],                                             // ...and it fired (in the breath)
  [95.96, .2, 'd4', .07], [96.45, .3, 'g4', .11, { release: .25 }],                         // a network (g in the breath)
  [96.98, .2, 'b4', .07], [97.9, .25, 'd5', .11, { release: .25 }],                         // a neural network (d in the breath)
  [99.6, .45, '[g4,d5]', .17, { release: .3 }],                                              // "logic" (in the breath)
  // AND: input A, input B, chime only when both sound
  [100.15, .25, 'e4', .16], [100.42, .25, 'a4', .16], [100.7, .6, '[g4,d5]', .3],
  // OR: one input, chime at once
  [101.39, .2, 'e4', .16], [101.6, .9, '[g4,d5]', .3],
  // M1 in G, LIT: D -> G on "light" / "intoFlame"
  // voice-band pass: D -> G 4.5 dB down and the G struck and let go (the strings hold the flame); the 3-s ring
  // had sat on "Each belief gets one" in the vowel band
  [111.29, .3, 'd4', .14, { release: .25 }], [111.95, 1.0, 'g4', .17, { release: .8 }],
  // Hebb: the passes are pinned to words ("cell" 129.01, "fire" 129.73, "grows" 131.24), so under L0211 they are
  // ghost touches, one note each; the thread THICKENS in the 3.5-s reading hold after "grows" (131.78-135.31):
  // B -> D three times, each fuller (celesta, + music box, + harp), the last decayed before "Alan" (135.31)
  [129.01, .3, 'b4', .07], [129.73, .3, 'b4', .075], [131.24, .3, 'b4', .08],
  [131.86, .3, 'b4', .2], [132.16, .7, 'd5', .23],
  [132.92, .3, 'b4', .22], [133.22, .7, 'd5', .26],
  [133.98, .32, 'b4', .2], [134.3, .6, 'd5', .22, { release: .45 }],
  // Widrow: M1's rising fourth, tender; then the line slides downhill and stops on E. Critic r1: everything
  // under L0216 (161.22-170.38) at <= .14, and the E lands after "wrong" (170.38), alone, at 170.42.
  [162.17, .42, 'd4', .13], [162.59, 2.0, 'g4', .14],
  [164.81, .4, 'a4', .1], [165.21, .9, 'b4', .11],
  // the E is struck in the breath after "wrong" and let go, so "Remember him" (170.98) is in near silence
  [168.2, .45, 'b4', .11], [168.65, .45, 'a4', .1], [169.1, .5, 'g4', .1], [169.6, .6, 'f#4', .1], [170.42, .35, 'e4', .15, { release: .45 }],
  // the X-ray: the rising fourth once more, softly, as if kept
  [192.21, .5, 'd4', .2], [192.71, 3, 'g4', .24],
])
  .s('gm_celesta').gain(G * .7).room(.6).rsize(5).orbit(2)

// music box: Hebb's thread thickening (passes 2-3), Turing's child machine (heard high)
$: line([
  [132.92, .3, 'b5', .12], [133.22, .7, 'd6', .14],
  [133.98, .32, 'b5', .14], [134.3, .6, 'd6', .15, { release: .45 }],
  // Turing: the rise under "child machine" 6 dB down; its top D arrives after "machine" (142.42), in the clear
  [141.47, .3, 'g5', .07], [141.77, .3, 'a5', .075], [142.05, .35, 'b5', .08], [142.5, 1.4, 'd6', .18],
])
  .s('gm_music_box').gain(G * .75).room(.6).rsize(5).orbit(2)

// harp: the third pass is the fullest; the Hebb hold
$: line([
  [133.98, 1.2, '[g3,b3,d4]', .1, { release: 1.0 }],     // the fullest pass, in the hold
])
  .s('gm_orchestral_harp').gain(G).release(2).lpf(2200).room(.5).rsize(4).orbit(2)

// ------------------------------------------------------------------ strings: low bed, the flame (G5), the chords
$: line([
  // the hand-off: m01's held D carried on, then the 1940s bed, low
  [72.35, 3.3, 'd4', .07, { attack: 1.4, release: 1.5 }],
  [74.3, 10.3, '[g2,d3]', .12, { attack: 2.5, release: 2 }],
  [84.5, 6.0, '[g2,d3]', .1, { attack: 1.5, release: 1.5 }],
  [91.0, 8.3, '[e2,b2]', .1, { attack: 1.5, release: 1.5 }],
  [99.6, 2.8, '[g2,d3,b3]', .12, { attack: .4, release: 1.2 }],                 // "logic" (in the breath)
  // THE FLAME: G5 held (lit), over G major; on "Gerard" the bass drops to D-A (doubted)
  [111.95, 15.2, 'g5', .04, { attack: 1.2, release: 3 }],      // voice-band pass: -4 dB under L0209
  [111.95, 9.0, '[g2,b2,d3]', .075, { attack: 1.4, release: 2 }],
  [120.98, 6.6, '[d2,a2,d3]', .12, { attack: 1.6, release: 2.5 }],
  // Hebb: a warm vi - IV under the thread
  [127.51, 4.0, '[e2,b2,g3]', .09, { attack: 1.5, release: 1.5 }],
  [131.24, 4.0, '[c2,g2,e3]', .1, { attack: 1.2, release: 2 }],
  // Turing: the hopeful turn IV - V - I under "educate a child machine"
  [137.3, 4.1, '[c2,g2,e3]', .085, { attack: 1.6, release: 1 }],             // starts under "proposed": no hole after Hebb
  [141.47, 1.0, '[d2,a2,f#3]', .11, { attack: .5, release: .8 }],
  [142.44, 1.2, '[g2,d3,b3]', .12, { attack: .4, release: 1 }],
  // a soft held G while the slip is read (no voice 143.05-148.14)
  [144.01, 3.3, '[g3,b3,d4,g4]', .19, { attack: 1.4, release: 1.1 }],
  // THE CANDLE OUT: the suspension (G5 over D-A), then the fall G -> F# on "sixteen" with D major
  [173.9, 11.44, 'g5', .085, { attack: 2, release: .25 }],
  [174.2, 11.14, '[d2,a2]', .13, { attack: 2, release: .3 }],
  [185.34, 1.4, 'f#5', .095, { attack: .08, release: 1.6 }],
  [185.34, 1.4, '[d2,a2]', .13, { attack: .08, release: 1.6 }],
  // the X-ray: open G (V of C), left ringing through the fade
  [192.71, 2.6, '[g2,d3]', .1, { attack: 1.2, release: 2.5 }],
], { attack: 1, release: 2 })
  .s('gm_string_ensemble_1').gain(G).lpf(1200).room(.6).rsize(5).orbit(4)

// high shimmer: bowed glass under the X-ray (heard high)
$: line([
  [192.21, 3.0, '[g5,d6]', .1, { attack: 1, release: 2.5 }],
])
  .s('gm_pad_bowed').gain(G).lpf(5000).room(.7).rsize(6).orbit(5)

