$: line([
  [74.5, 8.0, 'g2', .14, { attack: 2, release: 2 }],
  [106.66, 2.4, 'd2', .2, { attack: .4, release: 1.2 }],                        // "The nets could not learn"
  [161.21, 6.4, 'g2', .1, { attack: 2, release: 1.5 }],                         // Widrow's dream
  [167.81, 4.4, 'e2', .1, { attack: 1.2, release: 2 }],                         // downhill
  [173.6, 11.74, 'd2', .14, { attack: 2.2, release: .3 }],                      // the suspension's root
  [185.34, 1.6, 'd2', .15, { attack: .05, release: 1.6 }],                      // gone: the half cadence
  [192.71, 2.6, 'g1', .14, { attack: 1.2, release: 2.5 }],                      // the open G, V of C
], { attack: 1, release: 2 })
  .s('gm_cello').gain(G).lpf(700).room(.5).rsize(4).orbit(1)

// ------------------------------------------------------------------ M2: the walk and the file seal (pizz + clarinet)
