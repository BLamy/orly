  [76.90, .6, 'd5', .2, { release: .4 }],
  // the 1940s, curious: in the gaps
  [80.28, .25, 'd5', .2], [80.52, .32, 'c5', .16, { release: .2 }],                                           // after "Chicago, around 1941"
  [85.52, .3, 'b4', .22], [85.77, .3, 'a4', .2], [86.02, .3, 'g4', .2], [86.32, .5, 'a4', .2, { release: .35 }], // a question, gone before "In" (87.06)
  // the logic lanterns: pluck (input) / chime (fire). Voice-band pass (critic r1): under L0203/L0204 the plucks are
  // ghosts (~-6 dB) and the bright chimes sit in the breaths ('fired' -> 95.62, 'logic' -> 101.52); the one chime
  // the picture pins to a word ('fire' 89 = "All") is a single soft G, short, so "or nothing" is clear.
  [90.21, .3, 'e4', .08],                                                                   // input lights ("oneIn")
  [91.17, .1, 'g4', .025, { release: .07 }],                                                 // the wick catches on "All": a damped tick (word pass: halved, shortened)
  [91.57, .16, '[d4,g4]', .11, { release: .1 }],                                             // ...and blooms in the breath after "All" (flame lit): the firing dyad, gone before "or"
  // "dark" 92.16: rest
  [93.54, .2, 'e4', .062], [93.94, .2, 'e4', .067], [94.34, .2, 'e4', .071],              // enough signals at once...
  [95.62, .34, '[d4,g4]', .17, { release: .26 }],                                            // ...and it FIRED (in the breath): the candle's fourth as a dyad, heard D5-G5, under 1 kHz
  [97.88, .2, 'd4', .062], [98.37, .3, 'g4', .098, { release: .22 }],                       // a network (g in the breath)
  [98.90, .2, 'b4', .062], [99.82, .18, 'd5', .085, { release: .12 }],                       // a neural network (d in the 0.28-s breath, damped)
  [101.52, .45, '[g4,d5]', .17, { release: .3 }],                                              // "logic" (in the breath)
  // AND: input A, input B, chime only when both sound
  [102.07, .25, 'e4', .16], [102.34, .25, 'a4', .16], [102.62, .6, '[g4,d5]', .3],
  // OR: one input, chime at once
  [103.31, .2, 'e4', .16], [103.52, .9, '[g4,d5]', .3],
  // M1 in G, LIT: D -> G on "light" / "intoFlame"
  // voice-band pass: D -> G 4.5 dB down and the G struck and let go (the strings hold the flame); the 3-s ring
  // had sat on "Each belief gets one" in the vowel band
  [113.21, .3, 'd4', .14, { release: .25 }], [113.87, 1.0, 'g4', .17, { release: .8 }],
  // Hebb: the passes are pinned to words ("cell" 130.93, "fire" 131.65, "grows" 133.16), so under L0211 they are
