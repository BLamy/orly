  [102.96, .8, 'd2', .4], [103.87, .8, 'f2', .36], [104.78, .8, 'g2', .38], [105.69, .8, 'g#2', .38],   // the pinning; stops dead
  [109.05, .55, 'a2', .42], [109.62, 1.0, 'd2', .44],                                                    // FILE SEAL on "file"
  [143.15, .6, 'd2', .26], [143.71, .6, 'f2', .24], [144.27, .6, 'g2', .24], [144.83, 1.2, 'a2', .24],  // the slip pin, quietly
])
  .s('gm_pizzicato_strings').gain(G * .85).lpf(1500).room(.35).rsize(3).orbit(3)
$: line([
  [109.05, .57, 'a3', .2, { attack: .04, release: .3 }],
  [109.62, 1.0, 'd3', .2, { attack: .06, release: .5 }],      // the seal, then silence: gone before "We" (111.06)
])
  .s('gm_clarinet').gain(G).lpf(1400).room(.4).rsize(3).orbit(3)

// ------------------------------------------------------------------ DARTMOUTH: the valve-organ chorale
// voice-led, low and soft under the voice; the change to D falls in the gap after "intelligence" (152.91)
$: line([
  [147.61, 1.6, '[g2,d3,g3,b3]', .07, { lpf: 1050 }],                    // L0215 (148.14-152.91) sits on these: soft
  [149.21, 1.26, '[b1,d3,g3,b3]', .07, { lpf: 1050 }],
  [150.47, 1.2, '[c2,e3,g3,c4]', .09, { lpf: 1050 }],                    // "name"
  [151.67, 1.25, '[a1,e3,a3,c4]', .075, { lpf: 1050 }],
  [152.92, 1.0, '[d2,d3,f#3,a3]', .15],                   // the gap after "intelligence"
  [153.92, 1.3, '[d2,d3,g3,b3]', .11],                    // G/D
  [155.21, 1.3, '[e2,e3,g3,b3]', .09],                    // Em
  [156.51, 1.1, '[c2,e3,g3]', .08],                       // C
  [157.61, 3.4, 'g3', .08, { release: 1.2 }],             // thins to ONE note on "symbols"
], { attack: .25, release: .6, lpf: 1400 })
  .s('gm_drawbar_organ').gain(G).room(.55).rsize(5).orbit(6)

// room tone under "The paper that put it out..." (187.00-191.91): a sine D at about -30 dB, so the near
// silence never drops to digital silence before the X-ray
$: line([
  [186.6, 6.3, 'd2', .5, { attack: 1, release: 1.2 }],
])
  .s('sine').gain(.03).lpf(300).orbit(7)

// far-off train rumble under the 1940s (74.5-84.0)
$: s("~@2.15 brown@9.85 ~@113").slow(N)
  .attack(3).release(2).gain(.09).lpf(150).orbit(7)
