$: tl([56.10, 10.8, note("[a5,c6]@1 [bb5,c6]@4")]).s("gm_pad_bowed").velocity(.1).attack(1.5).release(3).room(.6).rsize(4)
// 'worked' (619.05 = 64.10): the X-ray's glassy shimmer
$: tl([64.06, 1.4, note("[f5 c6 a5 f6 c6 a6]")]).s("gm_fx_crystal").velocity(.14).room(.7).rsize(4)
$: tl([64.06, 1.4, note("[c5 f5 a5 c6]")]).s("gm_celesta").velocity(.12).room(.7).rsize(4)
// 'stopped listening' (621.85-622.59 = 66.90-67.64): F major slips to D minor underneath
// (revision: the bowed D pedal is released at 69.4 instead of being held to 71.5: its loop swells kept
// it at full level into the fade; now it decays from 69.4 and the piano's E is what rings at the join)
$: tl([66.90, 2.5, note("[d2,a2]")]).s("gm_cello").velocity(.16).attack(1).release(2.2).lpf(600).room(.5).rsize(4)
$: tl([66.90, 2.5, note("d2")]).s("gm_contrabass").velocity(.18).attack(1).release(2.2).lpf(380)
$: tl([66.90, 2.6, note("[a5,d6]")]).s("gm_pad_bowed").velocity(.07).attack(1).release(2.5).room(.6).rsize(4)
// PIANO enters alone the moment the line ends ('listening' ends 622.59 = 67.64): a falling D minor
// figure, three notes, stopping on E (the ninth, unresolved), handing over to m08's quiet-years piano,
// which completes it on D. (Revision: it used to start under 'listening' at 67.30, mid-band under the
// last word; now it is in the clear.) Last onset 68.40 (623.35, the E), by the 623.42 target.
$: tl([67.70, 1.4, note("a4 f4 e4@2")]).s("piano").velocity("[.31 .27 .25]").room(.6).rsize(4)
$: tl([68.38, 2.4, note("[d3,a3]")]).s("piano").velocity(.16).room(.6).rsize(4)

all(x => x.postgain(2.0))
