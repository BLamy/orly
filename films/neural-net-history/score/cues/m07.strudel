// m07 — THE RIVAL SUSPECT: the false-clue walk -> the knowledge boom (C major, brittle synth brass)
// -> the second winter (C minor, guttered) -> the messenger nobody heard (F major -> D minor, piano alone).
// Window 554.95-626.52 (71.57 s, clock 2139.54 s; re-fitted 2026-10-12: shifted +0.75 s bodily, no line inside it changed length, every cue-local hit re-checked against timeline.json). 76 BPM, one 4/4 bar per cycle.
// All times below are cue-local seconds (absolute - 554.95); tl() places one-shot gestures on the locked
// clock, so the cue is through-composed and ENDS: last onset 68.40 (623.35); the piano's unresolved E rings
// 1.7 s in clear air before the fade 625.02-626.52, into m08's D minor piano.
setcpm(76/4)
const CPS = 76/240, DUR = 71.57
// tl([t, d, pat], ...): pat stretched over [t, t+d] seconds; gaps are silence; total = DUR.
// Times are quantized to 1/128 bar (integer step weights) so the pattern arithmetic stays exact and fast.
const Q = 128, qn = s => Math.round(s * CPS * Q)
const tl = (...evs) => { const out = []; let cur = 0
  for (const [t, d, p] of evs) { const a = qn(t), b = qn(t + d); if (a < cur) throw new Error('tl overlap at ' + t)
    if (a > cur) out.push([a - cur, silence]); out.push([b - a, p]); cur = b }
  const end = qn(DUR); if (end > cur) out.push([end - cur, silence]); if (cur > end) throw new Error('tl past DUR')
  return stepcat(...out).slow(end / Q) }
const bars = s => qn(s) / Q // seconds -> bars, for .fast() of looping figures inside a slot

// ---- OPENING (moved from m06): the false-clue card turns over ('falseClue' 556.06 = 1.11,
// 'falseClueTurn' 557.06 = 2.11). M2's detective walk, wry and off-kilter, in C, dry and low: the
// chromatic step arrives a hair late; it stops dead as the card lands, leaving room for the match strike.
$: tl([0.30, 2.31, note("c2@2 eb2@2 f2@3 f#2@1 g2@4")]).s("gm_pizzicato_strings")
  .velocity("[.42 .36 .4 .3 .46]").lpf(1500).room(.3).rsize(3)
$: tl([2.11, 0.5, note("[c2,g2]")]).s("gm_contrabass").velocity(.22).release(.6).lpf(360)

// ---- M1 KNOWLEDGE CANDLE, lit on the match strike ('lit' 560.38 = 5.43): G -> C on bright, brittle synth
// brass, voiced high (G5 -> C6 sits above the voice) with a soft unison an octave down behind lpf.
$: tl([5.00, 3.87, note("g5 c6@8")]).s("gm_synth_brass_1").velocity(.18).attack(.02).release(1.6).lpf(4200).room(.45).rsize(4)
$: tl([5.00, 3.6, note("g4 c5@8")]).s("gm_synth_brass_1").velocity(.035).release(1.4).lpf(1100).room(.45).rsize(4)

// ---- the boom's harmony: low and bright, below D3 while he speaks; Fm/C under "never went into routine use"
$: tl(
  [2.60, 2.80, note("[c2,g2]")],
  [5.43, 3.15, note("[c2,g2,c3,e3]")],              // lit: C major under the held C
  [8.58, 3.25, note("[c2,g2,e3]")],                 // 'knowledge' (563.53): the typing begins
  [11.83, 3.08, note("[a1,e2,c3]")],                // 'system' (566.78)
  [14.91, 2.37, note("[f1,c2,a2]")],                // 'above Stanford'
  [17.28, 2.72, note("[c2,ab2,c3,f3]")],            // 'never' (572.23): the first shadow, Fm/C
  [20.00, 3.40, note("[c2,g2,e3]")],                // 'sea' (574.95)
  [23.40, 3.42, note("[a1,e2,c3]")],
  [26.82, 2.50, note("[f1,c2,a2]")]                 // the single held chord under "practically nothing"
).s("gm_string_ensemble_1").velocity(.14).attack(.5).release(2).lpf(900).room(.45).rsize(4)
$: tl([2.60, 14.68, note("c2")], [17.28, 2.72, note("c2")], [20.00, 9.4, note("<c2 a1 f1>").slow(3)])
  .s("gm_contrabass").velocity(.16).attack(.3).release(1.5).lpf(380)
// the held chord's high air under the quote (above D5)
$: tl([26.82, 2.6, note("[a5,c6,e6]")]).s("gm_pad_bowed").velocity(.09).attack(.6).release(2).room(.45).rsize(4)

// ---- the TYPING rhythm: woodblock clacks + feather-light pizz 16ths, high and dry. Starts on
// 'knowledge' (8.58), stops dead on 'never' (17.28) for a bar, returns softer on 'sea' (20.00), stops for
// the quote ('practically' 26.82), returns for Tokyo ('tokyo' 585.28 = 30.33).
const typeWB = note("a5 ~ a5 a5 ~ a5 ~ a5 a5 a5 ~ a5 ~ a5 a5 ~")
const typePZ = note("c6 g5 c6 g5 c6 g5 e6 g5 c6 g5 c6 g5 d6 g5 c6 g5")
$: tl([8.58, 8.70, typeWB.fast(bars(8.70)).velocity(.13)],
      [20.00, 6.8, typeWB.fast(bars(6.8)).velocity(.09)],
      [30.33, 5.0, typeWB.fast(bars(5.0)).velocity(.08)])
  .s("gm_woodblock").lpf(5000).room(.2).rsize(4)
$: tl([8.58, 8.70, typePZ.fast(bars(8.70)).velocity(perlin.range(.06, .12))],
      [20.00, 6.8, typePZ.fast(bars(6.8)).velocity(perlin.range(.04, .08))],
      [30.33, 5.0, typePZ.fast(bars(5.0)).velocity(perlin.range(.04, .07))])
  .s("gm_pizzicato_strings").lpf(6000).room(.2).rsize(4)

// ---- the rolling SEA ('sea' 574.95 = 20.00): harp arpeggio, low and rolling, a high glint on each crest.
// The Tokyo aside (30.33) gets the same figure, unchanged and equally warm.
const sea = note("c2 g2 c3 e3 g3 e3 c3 g2 a1 e2 a2 c3 e3 c3 a2 e2")
const sea2 = note("f1 c2 f2 a2 c3 a2 f2 c2 g1 d2 g2 b2 d3 b2 g2 d2")
$: tl([20.00, 6.8, sea.fast(bars(6.8)).velocity(.15)],      // under L0515: thinner, so the rolling stays below the voice
      [30.33, 2.53, sea.slow(2).velocity(.3)], [32.86, 2.48, sea2.slow(2).velocity(.27)])
  .s("gm_orchestral_harp").lpf(2400).room(.5).rsize(4)
$: tl([20.00, 6.8, note("[g5 ~ ~ ~] [~ ~ e5 ~]").fast(bars(6.8))], [30.33, 5.0, note("g5 ~ e5 ~ a5 ~ g5 ~")])
  .s("gm_orchestral_harp").velocity(.14).room(.5).rsize(4)

// ---- the FILE SEAL on 'file' (584.28 = 29.33), in the clear after L0515: A -> D, plucked, doubled by
// the low clarinet
$: tl([29.33, 1.1, note("a3 d3")]).s("gm_pizzicato_strings").velocity(.42).lpf(2000).room(.45).rsize(4)
$: tl([29.33, 1.5, note("a3 d3@2")]).s("gm_clarinet").velocity(.2).attack(.05).release(.8).lpf(1600).room(.45).rsize(4)

// ---- Tokyo's warmth: the speech gap 583.88-590.31 (28.93-35.36) is the boom's one swell
// (strings, C -> Am -> F -> G)
$: tl([30.33, 5.03, note("[c3,e3,g3,c4] [a2,e3,a3,c4] [f2,c3,f3,a3] [g2,d3,g3,b3]")])
  .s("gm_string_ensemble_1").velocity(.17).attack(.6).release(1.8).lpf(1500).room(.45).rsize(4)

// ---- THE SECOND WINTER. The panel ('panel' 590.31 = 35.36): the typing thins to ONE repeated note, a
// warning from inside; it dies away as Schank's card rises (592.04-594.15). C minor underneath.
$: tl([35.36, 3.6, note("g5*9").velocity("[.12 .11 .1 .09 .08 .07 .06 .05 .04]")])
  .s("gm_pizzicato_strings").lpf(5000).room(.3).rsize(4)
$: tl([35.36, 3.84, note("[c2,g2,eb3]")], [39.20, 3.9, note("[c2,g2,eb3]")])
  .s("gm_string_ensemble_1").velocity(.12).attack(1).release(2.5).lpf(800).room(.5).rsize(4)
$: tl([35.36, 11.65, note("c2")], [47.01, 1.35, note("ab1")], [48.36, 7.3, note("g1")])
  .s("gm_contrabass").velocity(.22).attack(.6).release(2.5).lpf(380)
// snow ('snow' 594.15 = 39.20): bowed glass, high and thin
$: tl([39.20, 7.6, note("[eb5,g5,c6]")]).s("gm_pad_bowed").velocity(.1).attack(2).release(3).room(.6).rsize(4)
// the speech gap 594.55-598.05 (39.60-43.10): the cello alone, a falling C minor phrase (a winter walk)
$: tl([39.75, 3.2, note("c3@2 bb2 ab2@2 g2@3")]).s("gm_cello").velocity(.3).attack(.12).release(1.4).lpf(1300).room(.5).rsize(4)

// ---- 'dark' (601.96 = 47.01): the bass sinks; Cyc's taper ('knowledge' 604.33 = 49.38) gets one thin
// high C that will not resolve; the knowledge candle's flame (cello C3 from 'candle' 49.75) falls on
// 'seven' (605.98 = 51.03) only to Bb, over G: guttered, not gone, never reaching the B that would
// resolve it. (2026-10-12 revision: this all sits under the end of L0522, so the celesta, glass, cello and
// strings are 2-3 dB softer: the fall is heard as a shading of the line, and the gap after it is the swell.)
$: tl([49.38, 6.0, note("c5")]).s("gm_celesta").velocity(.14).room(.6).rsize(4)
$: tl([49.38, 6.6, note("c6")]).s("gm_pad_bowed").velocity(.07).attack(1.2).release(3).room(.6).rsize(4)
$: tl([49.75, 6.4, note("c3 bb2@4")]).s("gm_cello").velocity("[.2 .24]").attack(.5).release(2).lpf(900).room(.5).rsize(4)
$: tl([51.03, 4.6, note("[g1,d2,g2]")]).s("gm_string_ensemble_1").velocity(.11).attack(.8).release(2.5).lpf(700).room(.5).rsize(4)

// ---- THE MESSENGER UNHEARD. Lead-in in the gap 606.85-611.27 (51.90-56.32): M3's forward arpeggio,
// slow and warm in F (celesta sounds an octave up), landing on F major as the dawnGold shot opens
// (610.67 = 55.72).
$: tl([53.40, 2.32, note("f3 a3 c4 f4@2")]).s("gm_celesta").velocity(.3).room(.6).rsize(4)
// (2026-10-12) the gap's one warm breath: F major strings in the middle register swell under the arpeggio
// and are released at 55.7 so they have thinned before "Two critics" (56.32); the low F pedal takes over.
$: tl([53.20, 2.50, note("[c3,f3,a3,c4]")]).s("gm_string_ensemble_1").velocity(.13).attack(1.1).release(1.1).lpf(1500).room(.5).rsize(4)
$: tl([55.72, 11.18, note("[f1,f2]")]).s("gm_contrabass").velocity(.13).attack(1).release(2).lpf(380)
$: tl([55.72, 11.18, note("[f2,c3]")]).s("gm_cello").velocity(.085).attack(1.2).release(2).lpf(700).room(.5).rsize(4)
// the critics (611.27-617.77): a held suspension above the voice, Bb over F (doubt); no resolution on
