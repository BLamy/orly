setcpm(15)
const CPS = 0.25, DUR = 209.845
const Q = 480, qn = s => Math.round(s * CPS * Q)
const tl = (...evs) => {
  evs = evs.filter(Boolean).map(([t, d, p]) => [Math.max(0, t), d, p]).sort((x, y) => x[0] - y[0])
  const out = [], end = qn(DUR); let cur = 0
  evs.forEach(([t, d, p], i) => {
    let a = Math.max(qn(t), cur); const b = Math.min(qn(t + d), end, i + 1 < evs.length ? qn(evs[i + 1][0]) : end)
    if (b - a < 2) return
    if (a > cur) out.push([a - cur, silence])
    out.push([b - a, p]); cur = b })
  if (end > cur) out.push([end - cur, silence])
  return stepcat(...out).slow(end / Q) }
const loop = (pat, d) => pat.fast(d * CPS)
const n = (t, d, ns, v = 0.2) => [t, d, note(typeof ns === 'string' && ns.includes(',') ? '[' + ns + ']' : ns).velocity(v)]
const felt = x => x.s("piano").gain(1.6).lpf(1800).release(1.8).room(0.3).rsize(4)
const harp = x => x.s("gm_orchestral_harp").gain(1.6).lpf(2200).release(2.4).room(0.32).rsize(4)
