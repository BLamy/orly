//   s03  celld's town in G (harp and a muted pad, B natural: the green colour); a dry low knock on each 'press'; on
//        'pressed' the knock again and T on 'ring', before any well sound; a faint low harp D for 'upload'.
//   s03b W slow in the cello for the lone house, then the bell after 'still correct'; a knock per running house; the
//        three-copies chord (the fullest moment so far) after 'three copies', thinned to two notes on 'two copies'.
//   s04  SILENCE for the failure from 'dies'; one hollow knock after 'Pull the pin'; a low held D under the shelves,
//        gone before 'Forty-two is gone'; the stale bell (D against E-flat) and T broken after 'one more bell'; the
//        green pad creeps back after 'Pin back'.
//   s05  parchment hush (the pad very low); a dry click on 'fence'; a soft thud on 'Seal' and on 'reach'; a low harp D
//        on 'upload'; the gate opens on a held piano A after 'restore', unresolved.
//   s06  case one resolves on a warm open fifth on 'proceeds'; a reversed breath into case two; S (A-sus4) from
//        'damaged', never resolving; T withheld; a single low muffled bell after the last line: a door that did not open.
//   s07  a patient two-bar pizzicato loop for the retries over S; S resolves to the open fifth D–A on 'relights';
//        T full and clear (A after 'whole', D after 'relights': LAST STRIKE), held warm into the iris.
setcpm(15)
const CPS = 0.25, DUR = 243.973
const Q = 480, qn = s => Math.round(s * CPS * Q)
const tl = (...evs) => {
  evs = evs.filter(Boolean).map(([t, d, p]) => [Math.max(0, t), d, p]).sort((x, y) => x[0] - y[0])
  const out = [], end = qn(DUR); let cur = 0
  evs.forEach(([t, d, p], i) => {
    let a = Math.max(qn(t), cur); const b = Math.min(qn(t + d), end, i + 1 < evs.length ? qn(evs[i + 1][0]) : end)
    if (b - a < 2) return
    if (a > cur) out.push([a - cur, silence])
    out.push([b - a, p]); cur = b })
  if (end > cur) out.push([end - cur, silence])
  return stepcat(...out).slow(end / Q) }
const n = (t, d, ns, v = 0.2) => [t, d, note(typeof ns === 'string' && ns.includes(',') ? '[' + ns + ']' : ns).velocity(v)]
const felt = x => x.s("piano").gain(1.6).lpf(1800).release(1.8).room(0.3).rsize(4)
const harp = x => x.s("gm_orchestral_harp").gain(1.6).lpf(2200).release(2.4).room(0.32).rsize(4)
