// m08 · WHAT TRAVELS (ch08) · D minor → D MAJOR at dawn (the F-sharp, withheld all film, arrives) · the end card
//   s01  alone in the hold: a low D minor pad. The four pins, one gesture each, in the breaths of L0801: the Tooth's
//        dry click (pizzicato D) · the candle's clock (A–D) · the second look's bell (harp D–A) · the seal's soft low
//        thud; one shared sting (D, E-flat, A) on 'Pull'; then a slow, steady clock ostinato (A–D) under the list of
//        parts, the harmony walking Dm · B-flat · C · Dm.
//   s02  the ostinato drops to a clerk's metronome (one A every two seconds); one soft harp A after the date (the
//        thirty-first: alarms); the G colour for one line under celld.
//   s03  the two lamps in ONE voice (piano): P's rising head and R's falling tail as a single line (A D E F · E D · A);
//        it thins to one held D as the camera finds the paper Well; a soft muted pluck after each thing the Well does
//        not do, the last barely there.
//   s04  DAWN: the drone opens into D major (strings D–F#–A) and a slow harp arpeggio in the gap; T slow on 'proof'
//        (A after 'feeling', D after 'proof', harmonised in D major for the first time); the bell after 'rang'; the
//        last chord, D major with an added ninth, strikes after 'The code is real' (LAST STRIKE) and rings in clear
//        air under the end card before the fade.
setcpm(15)
const CPS = 0.25, DUR = @{DUR}
const Q = 480, qn = s => Math.round(s * CPS * Q)
const tl = (...evs) => {
  evs = evs.filter(Boolean).map(([t, d, p]) => [Math.max(0, t), d, p]).sort((x, y) => x[0] - y[0])
  const out = [], end = qn(DUR); let cur = 0
  evs.forEach(([t, d, p], i) => {
    let a = Math.max(qn(t), cur); const b = Math.min(qn(t + d), end, i + 1 < evs.length ? qn(evs[i + 1][0]) : end)
    if (b - a < 2) return
    if (a > cur) out.push([a - cur, silence])
    out.push([b - a, p]); cur = b })
  if (end > cur) out.push([end - cur, silence])
  return stepcat(...out).slow(end / Q) }
const n = (t, d, ns, v = 0.2) => [t, d, note(typeof ns === 'string' && ns.includes(',') ? '[' + ns + ']' : ns).velocity(v)]
const felt = x => x.s("piano").gain(1.6).lpf(1800).release(1.8).room(0.3).rsize(4)
const harp = x => x.s("gm_orchestral_harp").gain(1.6).lpf(2200).release(2.4).room(0.32).rsize(4)
const pizz = x => x.s("gm_pizzicato_strings").gain(1.6).lpf(1400).release(0.5).room(0.25).rsize(4)
const str = (x, lp = 850, rel = 2.6) => x.s("gm_string_ensemble_1").gain(1.6).attack(1.6).release(rel).lpf(lp).room(0.35).rsize(4)
const drone = (x, rel = 3) => stack(x.s("triangle").lpf(380).gain(0.06), x.s("sawtooth").lpf(200).gain(0.028)).hpf(40).attack(3).release(rel)
const every = (t0, t1, step, notes, v) => { const o = []; let k = 0; for (let t = t0; t < t1 - 0.05; t += step, k++) o.push(n(t, Math.min(step, 0.5), notes[k % notes.length], v)); return o }
const END = @{L0818.end} + 0.3                                                    // the last chord

// ---------------------------------------------------------------- drone: dawn
$: drone(tl(n(@{L0814.end} + 0.1, @{DUR} - (@{L0814.end} + 0.1), "d2,a2", 1)), 4)

// ---------------------------------------------------------------- pads
$: str(tl(
    n(0.2, @{L0803} - 0.2, "d3,a3,f3", 0.17),
    n(@{L0803}, @{L0804} - @{L0803}, "d3,a3,f3", 0.17),
    n(@{L0804}, @{L0805} - @{L0804}, "bb2,f3,d4", 0.17),
    n(@{L0805}, @{L0805.end} - @{L0805}, "c3,g3,e4", 0.17),
    n(@{L0805.end}, @{L0810} - @{L0805.end}, "d3,a3", 0.15),
    n(@{L0810}, @{L0811} - @{L0810}, "g2,d3,b3", 0.15),                         // celld: the green colour
    n(@{L0811}, @{L0812} - @{L0811}, "d3,a3", 0.15),
    n(@{L0812}, @{L0814} - @{L0812}, "f2,c3,a3", 0.15),
    n(@{L0814}, @{L0814.end} - @{L0814}, "d3", 0.16),                           // the single held note
    n(@{L0814.end} + 0.1, @{DUR} - (@{L0814.end} + 0.1), "d3,f#3,a3", 0.15)), 850, 3)   // dawn: D major
$: str(tl(n(@{L0802.pull}, 1.3, "d3,eb3,a3", 0.2))).attack(0.06)                // the sting
$: str(tl(n(END, @{DUR} - END, "d2,a2,f#3", 0.17)), 700, 4)

// ---------------------------------------------------------------- piano: P + R in one voice; P's head in D major (A D E F#) at dawn, T; the last chord
$: felt(tl(
    n(@{L0811.end} + 0.2, 0.5, "a3", 0.15), n(@{L0811.end} + 0.7, 0.5, "d4", 0.15), n(@{L0811.end} + 1.2, 0.5, "e4", 0.15), n(@{L0811.end} + 1.7, 1.2, "f4", 0.15),
    n(@{L0812.more.end} + 0.02, 1.0, "e4", 0.12), n(@{L0812.stands.end} + 0.02, 1.0, "d4", 0.12), n(@{L0812.end} + 0.03, 2.0, "a3", 0.14),
    n(@{L0816.feeling.end} + 0.1, @{L0816.end} + 0.05 - (@{L0816.feeling.end} + 0.1), "a4", 0.17),
    n(@{L0816.end} + 0.05, 2.0, "d5,f#4", 0.17),                                 // T, in D major
    n(END, @{DUR} - END, "d4,f#4,a4,e5", 0.17)))                                 // LAST STRIKE

// ---------------------------------------------------------------- harp
$: harp(tl(
    n(@{L0801.look.end} + 0.02, 1.0, "d3,a3", 0.17),                              // the second look: the bell
    n(@{L0806.end} + 0.05, 1.5, "a4", 0.09),                                     // the thirty-first
    n(@{L0814.end} + 0.3, 0.6, "a3", 0.15), n(@{L0814.end} + 0.9, 0.6, "d4", 0.15), n(@{L0814.end} + 1.5, 0.6, "e4", 0.15), n(@{L0814.end} + 2.1, 1.5, "f#4", 0.14),   // P's head in D major
    n(@{L0816.end} + 0.05, 2.0, "d3,f#3,a3", 0.14),
    n(@{L0817.end} + 0.05, 1.2, "d3,a3", 0.17),                                   // the bell, after 'rang'
    n(END, @{DUR} - END, "d2,a2,d3,f#3,a3", 0.18)))

// ---------------------------------------------------------------- pizzicato: the pins, the clock, the metronome, the 'nots'
$: pizz(tl(
    n(@{L0801.tooth.end} + 0.02, 0.3, "d4", 0.17),                                // the Tooth: click
    n(@{L0801.candle.end} + 0.0, 0.2, "a2", 0.14), n(@{L0801.candle.end} + 0.2, 0.3, "d3", 0.14),   // the candle's clock
    ...every(@{L0803}, @{L0805.end}, 1.0, ["a2", "d3"], 0.1),
    ...every(@{L0806}, @{L0811.end}, 2.0, ["a2"], 0.08),
    n(@{L0814.code.end}, 0.4, "d3", 0.12), n(@{L0814.one.end}, 0.4, "d3", 0.09), n(@{L0814.once.end}, 0.4, "d3", 0.07), n(@{L0814.quiet.end}, 0.4, "d3", 0.04)))
$: pizz(tl(n(@{L0801.end} + 0.03, 0.5, "g2", 0.16))).lpf(500)                    // the seal: a soft low thud

all(x => x.postgain(1))
