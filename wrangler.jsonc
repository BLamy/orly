{
  // Cloudflare Workers static-assets deploy for the O'RLY shelf.
  // Prod:    `wrangler deploy`                -> https://orly.<subdomain>.workers.dev
  // Preview: `wrangler versions upload`       -> a per-version *.workers.dev preview URL
  "name": "orly",
  "compatibility_date": "2026-06-21",
  "assets": {
    "directory": "./dist",
    // SPA: serve index.html for unknown paths (routing is via ?bundle= / # anyway).
    "not_found_handling": "single-page-application"
  }
}
