{
  "$schema": "../../node_modules/nx/schemas/project-schema.json",
  "name": "bookshelf",
  "projectType": "application",
  "sourceRoot": "apps/bookshelf/src",
  "targets": {
    "dev": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run dev --workspace @orly/bookshelf"
      }
    },
    "build": {
      "executor": "nx:run-commands",
      "outputs": ["{workspaceRoot}/dist"],
      "options": {
        "command": "npm run build --workspace @orly/bookshelf"
      }
    },
    "preview": {
      "executor": "nx:run-commands",
      "options": {
        "command": "npm run preview --workspace @orly/bookshelf"
      }
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc -p apps/bookshelf/tsconfig.json --noEmit"
      }
    }
  }
}
