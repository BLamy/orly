              "repo": "chenglou/handwired@4ea7fcb27ebe93acf49b9f29a93e162b975bad46",
              "path": "lab/reusable-layout/README.md",
              "lines": "23",
              "quote": "Per-layout search starts from ordinary wrapping, scans ten possible widths for every item twice, then refines each width in steps of 16, 8, 4, 2, and 1 pixel."
            }
          ]
        },
