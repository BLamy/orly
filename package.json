{
  "name": "orly-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 'Secret Lives of Data'-style animated slideshow engine that renders a declarative story spec.",
  "workspaces": [
    "apps/*",
    "packages/mobile-ui"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @orly/bookshelf",
    "build": "nx run bookshelf:build",
    "build:packages": "if [ -f packages/viz-engine/package.json ]; then npm run build --prefix packages/viz-engine; else echo 'viz-engine submodule is not initialized; using the published package'; fi",
    "typecheck": "nx run mobile-ui:typecheck && npx tsc -p apps/bookshelf/tsconfig.json --noEmit && npx tsc -p apps/bookshelf/tsconfig.node.json",
    "nx": "nx",
    "publish:packages": "nx run viz-engine:publish",
    "preview": "npm run preview --workspace @orly/bookshelf",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "explain": "node generator/cli.mjs",
    "viz:narrate": "node generator/viz-narrate.mjs",
    "sync-books": "node generator/sync-issue-books.mjs",
    "cf:deploy": "wrangler deploy",
    "cf:preview": "wrangler versions upload",
    "lint:yaml": "node generator/lint-yaml.mjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "author": "node generator/run-opus.mjs",
    "test:authoring": "node --test generator/authoring-models.test.mjs generator/run-opus.test.mjs",
    "film:dev": "npm run dev --workspace @orly/bookshelf -- --port 5199 --strictPort --host 127.0.0.1",
    "film:voice": "node generator/film/voice.mjs",
    "film:narrate": "node generator/film/narrate.mjs",
    "film:stt": "node generator/film/stt.mjs",
    "film:timeline": "node generator/film/timeline.mjs",
    "film:score": "node generator/film/score.mjs",
    "book:score": "node generator/book-score.mjs",
    "book:sources": "node generator/book-sources.mjs",
    "film:mix": "node generator/film/mix.mjs",
    "film:render": "node generator/film/render.mjs",
    "film:edit-render": "node generator/film/edit-render.mjs",
    "film:stills": "node generator/film/stills.mjs",
    "film:sheets": "node generator/film/sheets.mjs",
    "film:qa": "node generator/film/qa.mjs",
    "film:publish": "node generator/film/publish.mjs",
    "film:snap": "node generator/film/snap.mjs",
    "film:check-workflows": "node tools/film/check-workflows.mjs",
    "film:ledger": "node generator/film/shot-ledger.mjs",
    "film:guard": "node generator/film/shot-guard.mjs",
    "film:cue-notes": "node generator/film/cue-notes.mjs",
    "film:test": "node --test generator/film/text.test.mjs generator/film/split.test.mjs generator/film/timeline.test.mjs generator/film/script.test.mjs generator/film/stt.test.mjs generator/film/shotledger.test.mjs apps/bookshelf/src/viz/film/silhouette/metaphors/xorRule.test.mjs apps/bookshelf/editor-server.test.ts 'apps/bookshelf/src/editor/**/*.test.ts'",
    "editor:test": "node --test apps/bookshelf/editor-server.test.ts 'apps/bookshelf/src/editor/**/*.test.ts'"
  },
  "dependencies": {
    "@brett_lamy/docstream": "^0.3.7",
    "@types/three": "^0.185.1",
    "d3": "^7.9.0",
    "framer-motion": "^11.0.0",
    "katex": "^0.17.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "rrweb": "2.0.0-alpha.20",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@agent-wasm/core": "^0.4.0",
    "@anthropic-ai/sdk": "^0.105.0",
    "@elevenlabs/elevenlabs-js": "^2.53.1",
    "@storybook/react-vite": "^10.4.6",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "js-yaml": "^5.0.0",
    "nx": "^22.7.5",
    "playwright": "^1.61.1",
    "sharp": "^0.34.5",
    "storybook": "^10.4.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-dts": "^4.5.4",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.103.0"
  }
}
