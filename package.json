{
  "name": "orly-monorepo",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 'Secret Lives of Data'-style animated slideshow engine that renders a declarative story spec.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @orly/bookshelf",
    "build": "npm run typecheck --workspace @orly/mobile-ui && npm run build --workspace @orly/bookshelf",
    "preview": "npm run preview --workspace @orly/bookshelf",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "explain": "node generator/cli.mjs",
    "viz:narrate": "node generator/viz-narrate.mjs",
    "sync-books": "node generator/sync-issue-books.mjs",
    "cf:deploy": "wrangler deploy",
    "cf:preview": "wrangler versions upload",
    "lint:yaml": "node generator/lint-yaml.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "@brett_lamy/docstream": "^0.1.0",
    "@types/three": "^0.185.1",
    "d3": "^7.9.0",
    "framer-motion": "^11.0.0",
    "katex": "^0.17.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.185.1",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@elevenlabs/elevenlabs-js": "^2.53.1",
    "@storybook/react-vite": "^10.4.6",
    "@types/d3": "^7.4.3",
    "@types/katex": "^0.16.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "js-yaml": "^5.0.0",
    "playwright": "^1.61.1",
    "sharp": "^0.34.5",
    "storybook": "^10.4.6",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "vite-plugin-pwa": "^1.3.0",
    "wrangler": "^4.103.0"
  }
}
