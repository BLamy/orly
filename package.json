{
  "name": "dataflow-slides",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A 'Secret Lives of Data'-style animated slideshow engine that renders a declarative story spec.",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "explain": "node generator/cli.mjs",
    "sync-books": "node generator/sync-issue-books.mjs",
    "cf:deploy": "wrangler deploy",
    "cf:preview": "wrangler versions upload",
    "lint:yaml": "node generator/lint-yaml.mjs",
    "prepare": "git config core.hooksPath .githooks || true"
  },
  "dependencies": {
    "d3": "^7.9.0",
    "framer-motion": "^11.0.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.105.0",
    "@elevenlabs/elevenlabs-js": "^2.53.1",
    "@types/d3": "^7.4.3",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "js-yaml": "^5.0.0",
    "typescript": "^5.5.4",
    "vite": "^5.4.0",
    "wrangler": "^4.103.0"
  }
}
