#!/bin/sh
# Fail the commit if the "✏️ Tweak a book" dropdown is out of sync with the
# library — i.e. you added/renamed a book but forgot to refresh the issue form.
# Activated via `npm install` (the package.json "prepare" sets core.hooksPath).

if ! node generator/sync-issue-books.mjs --check; then
  echo ""
  echo "  ↳ run:  node generator/sync-issue-books.mjs   then  git add .github/ISSUE_TEMPLATE/tweak-book.yml"
  exit 1
fi

# Lint any staged YAML files (must parse) so a broken workflow never lands.
STAGED_YAML=$(git diff --cached --name-only --diff-filter=ACM -- '*.yml' '*.yaml')
if [ -n "$STAGED_YAML" ]; then
  if ! node generator/lint-yaml.mjs $STAGED_YAML; then
    echo ""
    echo "  ↳ fix the YAML above, then re-stage and commit."
    exit 1
  fi
fi
